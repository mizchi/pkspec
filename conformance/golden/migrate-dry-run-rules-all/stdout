scenarios {
  new {
    id = "demo"
    implementations {
      new CodeImpl { at = "internal/x.go:Foo" }
    }
    progressMethod = "severity-weighted"
    inlineStdout = new InlineSnapshot {}
    inlineStderr = new InlineSnapshot { state = "match"; value = "err\n" }
    given {
      new SpecStep {
        description = "seed"
        impl = new Step {
          body = new ShellBody {
            cmd = "echo seed"
            captureStdout = "S"
          }
        }
      }
    }
    audienceNotes { ["pm"] = "pm only" }
  }
}
