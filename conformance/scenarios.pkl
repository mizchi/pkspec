      fsDelta = true
      mustContainStderr { "wrote SPEC.md (5 entries)" }
    }
  }
  // ── P3d: exec --update-inline-snapshots (Test.pkl source rewrite) ─────
  //
  // exec-inline-rewrite: the fixture's CmdTest carries a STALE inline snapshot
  // (`value = "STALE\n"`) that does not match the deterministic `echo pong`
  // output. With `--update-inline-snapshots`, the runner REWRITES the Test.pkl
  // SOURCE in place (atomic tmp+rename) — replacing the RHS with
  // `new InlineSnapshot { state = "match"; value = "pong\n" }` — and the test
  // then PASSES (exit 0). This is a MODIFICATION of a committed file, not a
  // creation; the harness's content-hash snapshot registers it in fsDelta. The
  // transient `Test.pkl.pkspec.tmp` is renamed away, so it never appears.
  //
  // The rewrite is fully deterministic (echo pong is fixed), so the normalized
  // stderr — the `[pkspec] inlineStdout for "echo_pong" updated (5 bytes)`
  // notice, the passing progress line, and the green summary — is gated at byte
  // parity (exactStderr + normalizeDurations). fsDelta asserts the rewritten
  // `examples/exec-inline-rewrite/Test.pkl` is the only changed path, matching
  // the oracle. The rewritten CONTENT's byte-for-byte parity vs Go is verified
  // separately by the all-examples sweep (it is identical there); here fsDelta
  // gates that the SAME file set is touched.
  new {
    id = "exec-inline-rewrite"
    fixture = "conformance/fixtures/exec-inline-rewrite"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-inline-rewrite" }
    argv { "exec"; "-f"; "Test.pkl"; "--update-inline-snapshots"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      fsDelta = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // ── P4a: exec http step + cassette record/replay ─────────────────────
  //
  // Same oracle CLASS 2 gating as the other exec scenarios. The HERMETIC path
  // is a cassette REPLAY with `--http-replay-only`: NO live server (the
  // examples/http-basic + examples/background-server live-server fixtures are
  // EXCLUDED — non-deterministic ports + network). The fixture is hand-authored
  // (not vendored from examples/http-cassette, which has a background server):
  // a single GET HttpBody step + a COMMITTED cassette `.pkspec/http/
  // counter_first.json` whose body is `{"call": 1}` and whose hash =
  // sha256("GET\n<url>\n") (empty request body), so the step PASSES
  // deterministically with no network. The committed cassette was obtained by
  // hand-authoring it to match what the example expects (the live
  // examples/http-cassette counter increments per request, so a recorded value
  // is volatile); the Go oracle replays the SAME committed cassette
  // byte-identically (verified in the P4a parity diff). Gate exit 0 + empty
  // stdout + the normalized stderr (passing progress line + green summary).
  //
  // EXCLUDED (live server / non-deterministic, NOT gated here):
  //   - http-basic         (background python server + free-ish fixed port)
  //   - background-server  (live server lifecycle)
  // DEFERRED (later sub-phases, error loudly): sql / playwright / quickcheck.
  new {
    id = "exec-http-cassette"
    fixture = "conformance/fixtures/exec-http-cassette"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-http-cassette" }
    argv { "exec"; "-f"; "Test.pkl"; "--http-replay-only"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // ── P4b: exec sql step (via the sqlite3 CLI shell-out) ───────────────
  //
  // Same oracle CLASS 2 gating as the other exec scenarios. The `sql` step kind
  // is DETERMINISTIC (in-memory / local-file SQLite, no network), so each gates
  // the normalized stderr at byte parity (exactStderr + normalizeDurations) with
  // stdout asserted empty (sql row output is captured + asserted, not echoed).
  // The MoonBit binary shells out to `sqlite3` (preinstalled on the GitHub
  // ubuntu/macos runners); the Go oracle that produced the goldens embeds
  // modernc.org/sqlite — the rows-JSON / rowcount OUTCOMES are identical, which
  // is what these gate. EXCLUDED (deferred, error loudly): playwright /
  // quickcheck / AI.
  //
  // exec-sql-select: examples/sql-select verbatim — a single `:memory:` step
  // that seeds via `WITH seed(...) VALUES ... SELECT` and asserts expectRowCount
  // + expectRowsJsonPath. Self-contained (no .db file), PASSES, exit 0.
  new {
    id = "exec-sql-select"
    fixture = "conformance/fixtures/exec-sql-select"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-sql-select" }
