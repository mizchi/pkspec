  // UPDATE → SELECT → DELETE → SELECT sequence against a local `work.db`,
  // exercising the DML rowcount (changes()) path + the read path. A trailing
  // shell step `rm -f work.db` cleans the file, so the run is net-zero on the
  // file system (no fsDelta gate). PASSES, exit 0.
  new {
    id = "exec-sql-dml"
    fixture = "conformance/fixtures/exec-sql-dml"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-sql-dml" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
