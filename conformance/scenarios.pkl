      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-junit: `exec --junit-reports reports` on a pass+fail fixture writes
  // `reports/Test.xml`. The XML's `time` + `classname` attrs are volatile, so
  // the CONTENT is gated by the all-examples sweep (byte-identical after
  // normalizing those two attrs), NOT here; this scenario gates the FILE is
  // emitted (fsDelta on `reports/Test.xml`) + the run's exit 1 + the normalized
  // stderr progress / summary (exactStderr + normalizeDurations).
  new {
    id = "exec-junit"
    fixture = "conformance/fixtures/exec-junit"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-junit" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings"; "--junit-reports"; "reports" }
    contract = new {
