/// Self-contained P0 conformance scenarios for pkspec-mbt. The schema
/// classes are inlined (no `amends`) so the harness can evaluate this with
/// a bare AnalysisSession — the full amends/package:// loader is a P1
/// concern. P1+ will split the schema back out into Conformance.pkl and
/// `amends` it here, once the embedded loader handles the real schemas.
module pkspec.conformance.scenarios

class Contract {
  json: Boolean = false
  unorderedPaths: Listing<String> = new {}
  jsonIgnorePaths: Listing<String> = new {}
  exit: Boolean = true
  mustContain: Listing<String> = new {}
  fsDelta: Boolean = false
  env: Boolean = false
  mustContainStderr: Listing<String> = new {}
  stdoutEmpty: Boolean = false
  stdoutNonEmpty: Boolean = false
  exactStdout: Boolean = false
}

class Scenario {
  id: String(matches(Regex(#"^[a-z0-9][a-z0-9-]*$"#)))
  fixture: String
  argv: Listing<String>
  env: Mapping<String, String> = new {}
  setup: Listing<String> = new {}
  contract: Contract
}

scenarios: Listing<Scenario> = new {
  // version differs by design (Go 0.3.0 vs MoonBit 0.4.0), so assert only
  // exit code + non-empty stdout — this proves dispatch + capture plumbing.
  new {
    id = "version"
    fixture = "conformance/fixtures/empty"
    argv { "version" }
    contract = new {
      exit = true
      stdoutNonEmpty = true
    }
  }
  // help text is semantic-equivalent across impls; assert a stable marker.
  new {
    id = "help"
    fixture = "conformance/fixtures/empty"
    argv { "help" }
    contract = new {
      exit = true
      mustContain { "pkspec" }
    }
  }
  // coverage is a deterministic pure function of the input Pkl, so its
  // Markdown is gated at byte parity (normalized) vs the Go oracle.
  //
  // The fixtures are self-contained: they vendor the pkl/ schema tree
  // alongside the example two levels deep (examples/<name>/), and the binary
  // runs from that subdir (PKF_CONFORMANCE_SUBDIR), so the example's verbatim
  // `amends "../../pkl/Spec.pkl"` resolves inside the copied temp tree. The
  // example .pkl files are copied UNMODIFIED from examples/<name>/. See
  // conformance/fixtures/README.md.
  //
  // spec-id: a 3-scenario / 2-implemented fixture (67%).
  new {
    id = "coverage-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "coverage"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec-graph: richer coverage — all three severities + all three review
  // statuses + four unimplemented ids.
  new {
    id = "coverage-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "coverage"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // orphans on spec-id: every active test references a spec id, so the
  // listing is empty — exercising the deterministic "(0)" path. (A
  // non-empty orphans listing prints the absolute SourcePath, which is the
  // per-run temp dir, so it is intentionally not gated as a committed
  // golden; that path is byte-diffed locally in Task 3 Step 5 instead.)
  new {
    id = "orphans-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "orphans"; "--root"; "."; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec-open-questions: the 3 Test.pkl stubs are auto-pending (tagged "spec"
  // with no runnable body — Go's isPending via Mode()==ModeInvalid). They
  // carry specRef but, being pending, do NOT count as implementing, so
  // coverage is 0 / 3. Regression gate for the auto-pending Mode/isPending
  // port — without it the model would over-count these as implemented.
  new {
    id = "coverage-spec-open-questions"
    fixture = "conformance/fixtures/spec-open-questions"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-open-questions" }
    argv { "coverage"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec-pending: the two body-less stubs (rejects_duplicate_email /
  // rejects_invalid_email) are tagged "spec" with no runnable body, so Go's
  // isPending (Mode()==ModeInvalid) auto-pends them — pending tests are
  // excluded from the orphans listing — and the one implemented test
  // (creates_user) carries a specRef, so it is not an orphan either. The
  // oracle therefore prints the deterministic "(0)" listing (no abs path),
  // gated with exactStdout. This is the direct regression for the auto-
  // pending fix: WITHOUT it the candidate wrongly lists the two stubs as
  // "# Orphan tests (2)", which fails this exact golden.
  new {
    id = "orphans-spec-pending"
    fixture = "conformance/fixtures/spec-pending"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-pending" }
    argv { "orphans"; "--root"; "."; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // decisions on spec-graph: two scenarios (AUTH-001, AUTH-005) carry
  // append-only Decision entries dated 2026-03-01. The flattened log is
  // newest-first (date DESC, spec-id ASC), entirely deterministic (no abs
  // paths), so it is gated at byte parity.
  new {
    id = "decisions-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "decisions"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // decisions on spec-id: no scenario declares a Decision, so the log is the
  // deterministic "_No decisions recorded._" empty state.
  new {
    id = "decisions-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "decisions"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // implementations on spec-id: each spec id with its active test backlink.
  // The test SourcePath relativizes to `Test.pkl` via `--root .`, so the
  // index is deterministic (no abs paths) and gated at byte parity.
  new {
    id = "implementations-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "implementations"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // implementations on spec-graph: mixes implemented (test backlink) and
  // "_No active implementation._" rows plus a "⊘ deprecated" badge (AUTH-005).
  new {
    id = "implementations-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "implementations"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // next on spec-graph: three unimplemented non-draft, non-deprecated specs
  // ranked by Goal priority then severity; exercises severity / status /
  // contributes / open-questions bullets. Fully deterministic.
  new {
    id = "next-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "next"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // next on spec-id: one unimplemented spec (SIGNUP-003), no Goals — the
  // minimal numbered-entry path.
  new {
    id = "next-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "next"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec on spec-id: the full SPEC.md — grouped by source dir (relativized
  // via `--root .` to `./`) -> module -> test, with checkboxes, verifies/tags,
  // blockquoted descriptions, cmd-body + inline-stdout expectations, and the
  // trailing "## Spec implementation index". Deterministic (paths relativize
  // to `Spec.pkl`/`Test.pkl`), gated at byte parity.
  new {
    id = "spec-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "spec"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec on spec-graph: the rich SPEC path — scenario badges (⊘ deprecated /
  // severity / [reviewStatus]), the outstanding-questions banner + tail,
  // scenario-meta bullets (sub-spec of / contributes / depends on / replaced
  // by / deprecated / decisions count), prelude-injected step labels, and
  // the implementation index. Fully deterministic.
  new {
    id = "spec-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "spec"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // ── P2c: goals / milestones / docs / check ──────────────────────────
  //
  // goals on spec-graph: three non-deprecated Goals ranked priority DESC,
  // each with its contributing-spec checklist (unimplemented first, id ASC),
  // severity/status badges, blockquoted rationale, and the scenario-count
  // progress line. The truncating `progressPercent` (int()) — NOT coverage's
  // round-half-even — is load-bearing here (66% not 67%, 95% not 96%).
  new {
    id = "goals-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "goals"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // goals on spec-id: no Goals declared — the deterministic empty state.
  new {
    id = "goals-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "goals"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // goals on spec-docs: a single approved Goal with a rationale and a fully
  // implemented contributing-spec list (severity-major rows omit the badge).
  new {
    id = "goals-spec-docs"
    fixture = "conformance/fixtures/spec-docs"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-docs" }
    argv { "goals"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // milestones on spec-docs: one Milestone with a due date, approved status,
  // and a goal rollup at 100% via goal-average — exercises the `[x]` mark and
  // the per-Goal inline progress fragment.

}
