  // spec --output PATH: write the rendered SPEC.md to a file (atomic tmp+rename)
  // instead of stdout, print the `pkspec: wrote <path> (N entries)` notice on
  // STDERR, exit 0. `fsDelta = true` makes the harness assert the created file
  // set matches the oracle (SPEC.md, and the transient SPEC.md.tmp is renamed
  // away so it does not appear). stdout stays empty.
  new {
    id = "spec-output-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "spec"; "--root"; "."; "--output"; "SPEC.md"; "Spec.pkl"; "Test.pkl" }
    contract = new {
