      normalizeDurations = true
    }
  }
  // exec-sql-parameterised: examples/sql-parameterised verbatim — `?`
  // placeholders bound from `args` (one via `$TARGET_EMAIL`) plus an injection
  // probe (`'; DROP TABLE users; --` lands as an inert string literal, table
  // stays intact). Net-zero on the file system (trailing `rm -f work.db`).
  // PASSES, exit 0.
  new {
    id = "exec-sql-parameterised"
    fixture = "conformance/fixtures/exec-sql-parameterised"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-sql-parameterised" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
