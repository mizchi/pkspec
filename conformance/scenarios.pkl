/// Self-contained P0 conformance scenarios for pkspec-mbt. The schema
/// classes are inlined (no `amends`) so the harness can evaluate this with
/// a bare AnalysisSession — the full amends/package:// loader is a P1
/// concern. P1+ will split the schema back out into Conformance.pkl and
/// `amends` it here, once the embedded loader handles the real schemas.
module pkspec.conformance.scenarios

class Contract {
  json: Boolean = false
  unorderedPaths: Listing<String> = new {}
  jsonIgnorePaths: Listing<String> = new {}
  exit: Boolean = true
  mustContain: Listing<String> = new {}
  fsDelta: Boolean = false
  env: Boolean = false
  mustContainStderr: Listing<String> = new {}
  stdoutEmpty: Boolean = false
  stdoutNonEmpty: Boolean = false
  exactStdout: Boolean = false
  // exactStderr gates the normalized STDERR stream at byte parity. Used by the
  // `exec` executor scenarios, whose progress + summary lines go to stderr.
  exactStderr: Boolean = false
  // normalizeDurations replaces every `(<num><unit>)` duration token with
  // `(DUR)` on BOTH sides before the exact compare, so the otherwise-volatile
  // wall-clock in `exec`'s progress / summary output does not break parity.
  normalizeDurations: Boolean = false
  // normalizeDate replaces the volatile current-date token the
  // `lint.future-decision-date` rule emits (`today UTC: YYYY-MM-DD`) with
  // `today UTC: <DATE>` on BOTH sides before the exactStdout compare, so a
  // golden captured on one day still matches a candidate run on a later day.
  // Anchored to `today UTC: ` so it never touches the INPUT decision date.
  normalizeDate: Boolean = false
}

class Scenario {
  id: String(matches(Regex(#"^[a-z0-9][a-z0-9-]*$"#)))
  fixture: String
  argv: Listing<String>
  env: Mapping<String, String> = new {}
  setup: Listing<String> = new {}
  contract: Contract
}

scenarios: Listing<Scenario> = new {
  // version differs by design (Go 0.3.0 vs MoonBit 0.4.0), so assert only
  // exit code + non-empty stdout — this proves dispatch + capture plumbing.
  new {
    id = "version"
    fixture = "conformance/fixtures/empty"
    argv { "version" }
    contract = new {
      exit = true
      stdoutNonEmpty = true
    }
  }
  // help text is semantic-equivalent across impls; assert a stable marker.
  new {
    id = "help"
    fixture = "conformance/fixtures/empty"
    argv { "help" }
    contract = new {
      exit = true
      mustContain { "pkspec" }
    }
  }
  // coverage is a deterministic pure function of the input Pkl, so its
  // Markdown is gated at byte parity (normalized) vs the Go oracle.
  //
  // The fixtures are self-contained: they vendor the pkl/ schema tree
  // alongside the example two levels deep (examples/<name>/), and the binary
  // runs from that subdir (PKF_CONFORMANCE_SUBDIR), so the example's verbatim
  // `amends "../../pkl/Spec.pkl"` resolves inside the copied temp tree. The
  // example .pkl files are copied UNMODIFIED from examples/<name>/. See
  // conformance/fixtures/README.md.
  //
  // spec-id: a 3-scenario / 2-implemented fixture (67%).
  new {
    id = "coverage-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "coverage"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec-graph: richer coverage — all three severities + all three review
  // statuses + four unimplemented ids.
  new {
    id = "coverage-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "coverage"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // orphans on spec-id: every active test references a spec id, so the
  // listing is empty — exercising the deterministic "(0)" path. (A
  // non-empty orphans listing prints the absolute SourcePath, which is the
  // per-run temp dir, so it is intentionally not gated as a committed
  // golden; that path is byte-diffed locally in Task 3 Step 5 instead.)
  new {
    id = "orphans-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "orphans"; "--root"; "."; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec-open-questions: the 3 Test.pkl stubs are auto-pending (tagged "spec"
  // with no runnable body — Go's isPending via Mode()==ModeInvalid). They
  // carry specRef but, being pending, do NOT count as implementing, so
  // coverage is 0 / 3. Regression gate for the auto-pending Mode/isPending
  // port — without it the model would over-count these as implemented.
  new {
    id = "coverage-spec-open-questions"
    fixture = "conformance/fixtures/spec-open-questions"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-open-questions" }
    argv { "coverage"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec-pending: the two body-less stubs (rejects_duplicate_email /
  // rejects_invalid_email) are tagged "spec" with no runnable body, so Go's
  // isPending (Mode()==ModeInvalid) auto-pends them — pending tests are
  // excluded from the orphans listing — and the one implemented test
  // (creates_user) carries a specRef, so it is not an orphan either. The
  // oracle therefore prints the deterministic "(0)" listing (no abs path),
  // gated with exactStdout. This is the direct regression for the auto-
  // pending fix: WITHOUT it the candidate wrongly lists the two stubs as
  // "# Orphan tests (2)", which fails this exact golden.
  new {
    id = "orphans-spec-pending"
    fixture = "conformance/fixtures/spec-pending"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-pending" }
    argv { "orphans"; "--root"; "."; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // decisions on spec-graph: two scenarios (AUTH-001, AUTH-005) carry
  // append-only Decision entries dated 2026-03-01. The flattened log is
  // newest-first (date DESC, spec-id ASC), entirely deterministic (no abs
  // paths), so it is gated at byte parity.
  new {
    id = "decisions-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "decisions"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // decisions on spec-id: no scenario declares a Decision, so the log is the
  // deterministic "_No decisions recorded._" empty state.
  new {
    id = "decisions-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "decisions"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // implementations on spec-id: each spec id with its active test backlink.
  // The test SourcePath relativizes to `Test.pkl` via `--root .`, so the
  // index is deterministic (no abs paths) and gated at byte parity.
  new {
    id = "implementations-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "implementations"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // implementations on spec-graph: mixes implemented (test backlink) and
  // "_No active implementation._" rows plus a "⊘ deprecated" badge (AUTH-005).
  new {
    id = "implementations-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "implementations"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // next on spec-graph: three unimplemented non-draft, non-deprecated specs
  // ranked by Goal priority then severity; exercises severity / status /
  // contributes / open-questions bullets. Fully deterministic.
  new {
    id = "next-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "next"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // next on spec-id: one unimplemented spec (SIGNUP-003), no Goals — the
  // minimal numbered-entry path.
  new {
    id = "next-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "next"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec on spec-id: the full SPEC.md — grouped by source dir (relativized
  // via `--root .` to `./`) -> module -> test, with checkboxes, verifies/tags,
  // blockquoted descriptions, cmd-body + inline-stdout expectations, and the
  // trailing "## Spec implementation index". Deterministic (paths relativize
  // to `Spec.pkl`/`Test.pkl`), gated at byte parity.
  new {
    id = "spec-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "spec"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // spec on spec-graph: the rich SPEC path — scenario badges (⊘ deprecated /
  // severity / [reviewStatus]), the outstanding-questions banner + tail,
  // scenario-meta bullets (sub-spec of / contributes / depends on / replaced
  // by / deprecated / decisions count), prelude-injected step labels, and
  // the implementation index. Fully deterministic.
  new {
    id = "spec-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "spec"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // ── P2c: goals / milestones / docs / check ──────────────────────────
  //
  // goals on spec-graph: three non-deprecated Goals ranked priority DESC,
  // each with its contributing-spec checklist (unimplemented first, id ASC),
  // severity/status badges, blockquoted rationale, and the scenario-count
  // progress line. The truncating `progressPercent` (int()) — NOT coverage's
  // round-half-even — is load-bearing here (66% not 67%, 95% not 96%).
  new {
    id = "goals-spec-graph"
    fixture = "conformance/fixtures/spec-graph"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-graph" }
    argv { "goals"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // goals on spec-id: no Goals declared — the deterministic empty state.
  new {
    id = "goals-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "goals"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // goals on spec-docs: a single approved Goal with a rationale and a fully
  // implemented contributing-spec list (severity-major rows omit the badge).
  new {
    id = "goals-spec-docs"
    fixture = "conformance/fixtures/spec-docs"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-docs" }
    argv { "goals"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // milestones on spec-docs: one Milestone with a due date, approved status,
  // and a goal rollup at 100% via goal-average — exercises the `[x]` mark and
  // the per-Goal inline progress fragment.
  new {
    id = "milestones-spec-docs"
    fixture = "conformance/fixtures/spec-docs"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-docs" }
    argv { "milestones"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // milestones on spec-id: no Milestones declared — the empty state.
  new {
    id = "milestones-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "milestones"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // docs --audience developer on spec-docs: the full docs surface — the Goals
  // section, per-scenario H3, meta bullets, the Behavior subsection (named
  // steps), and Open questions / Decisions (developer profile). Implementation
  // is hidden (the default). Deterministic; gated at byte parity.
  new {
    id = "docs-developer-spec-docs"
    fixture = "conformance/fixtures/spec-docs"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-docs" }
    argv { "docs"; "--audience"; "developer"; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // docs --audience end-user on spec-docs: the minimal profile (no Goals
  // lifecycle detail, no meta/questions/decisions) plus the audienceNotes
  // override on DOC-SIGNUP-001's description.
  new {
    id = "docs-end-user-spec-docs"
    fixture = "conformance/fixtures/spec-docs"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-docs" }
    argv { "docs"; "--audience"; "end-user"; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // check on spec-docs: every declared spec has a test backlink, so check
  // PASSES — stdout success line, exit 0.
  new {
    id = "check-pass-spec-docs"
    fixture = "conformance/fixtures/spec-docs"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-docs" }
    argv { "check"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // check on spec-id: SIGNUP-003 has no implementing test, so check FAILS —
  // exit 1, empty stdout, and the grouped unimplemented report on STDERR.
  new {
    id = "check-fail-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "check"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr {
        "1 unimplemented spec(s) — 0 critical, 1 major, 0 minor"
        "SIGNUP-003 (major; declared in: rejects invalid email)"
        "1 unimplemented spec(s), 0 missing impl path(s)"
      }
    }
  }
  // check --strict on spec-strict-missing: the spec is implemented via a
  // CodeImpl (bare check would pass), but its `at` file does not exist, so
  // --strict FAILS — exit 1, empty stdout, the missing-path report on STDERR.
  new {
    id = "check-strict-fail-spec-strict-missing"
    fixture = "conformance/fixtures/spec-strict-missing"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-strict-missing" }
    argv { "check"; "--strict"; "--root"; "."; "Spec.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr {
        "--strict: 1 implementedAt path(s) missing"
        "STRICT-001 → examples/spec-strict-missing/does-not-exist.go (file not found)"
        "0 unimplemented spec(s), 1 missing impl path(s)"
      }
    }
  }
  // docs with NO --audience: the required-flag error path. Go (and now the
  // candidate) route the error to STDERR and exit 1 with stdout empty —
  // regression gate for the stdout-vs-stderr routing fix.
  new {
    id = "docs-missing-audience-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "docs"; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "requires --audience" }
    }
  }
  // ── P2d: graph / lint / doctor + parity cleanups ────────────────────
  //
  // graph on spec-strict-missing: the only fully-deterministic graph fixture.
  // Its sole implementation is a CodeImpl whose `at` is a repo-relative path
  // (`examples/.../does-not-exist.go:DoesNotExist`), so the impl node id and
  // edge carry NO absolute path — unlike a test backlink, whose node id embeds
  // the abs SourcePath (per-run temp dir) and is therefore not byte-stable.
  // Gated at byte parity (rankdir/node-style preamble, the red→orange severity
  // colour, the `component`-shaped blue impl node, the `implements` edge).
  new {
    id = "graph-spec-strict-missing"
    fixture = "conformance/fixtures/spec-strict-missing"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-strict-missing" }
    argv { "graph"; "--root"; "."; "Spec.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // lint on spec-lint: a deliberately malformed spec that trips a broad spread
  // of rules across all three levels — four broken-ref.* (dependsOn/supersedes/
  // parent/replacedBy), critical-approved-with-open-questions,
  // approved-with-open-questions, critical-without-contributes,
  // deprecated-specRef, future-decision-date (a 2099 date), missing-description,
  // deprecated-without-replacedBy, and unknown-domain-prefix. The lint report
  // is deterministic (subjects are spec ids / `<base>:<name>`) EXCEPT the
  // future-decision-date row, which embeds the runtime `today UTC: YYYY-MM-DD`;
  // normalizeDate replaces that token (anchored to `today UTC: `, so the input
  // 2099 decision date is untouched) so the committed golden stays valid as the
  // clock advances. Byte parity (post-normalization) + exit 1.
  new {
    id = "lint-spec-lint"
    fixture = "conformance/fixtures/spec-lint"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-lint" }
    argv { "lint"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
      normalizeDate = true
    }
  }
  // lint --scan on spec-lint: same module plus a `--scan .` walk over the
  // vendored impl.go, which carries one live marker (LINT-001) and two dead
  // ones (LINT-GONE ×2). Adds the lint.dead-source-specRef row (subject
  // `impl.go:6`, count 2). Same future-decision-date / normalizeDate handling
  // as lint-spec-lint. Byte parity (post-normalization) + exit 1.
  new {
    id = "lint-scan-spec-lint"
    fixture = "conformance/fixtures/spec-lint"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-lint" }
    argv { "lint"; "--root"; "."; "--scan"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
      normalizeDate = true
    }
  }
  // lint on spec-id: a clean module — the deterministic `lint: clean (0 issues)`
  // path, exit 0.
  new {
    id = "lint-clean-spec-id"
    fixture = "conformance/fixtures/spec-id"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/spec-id" }
    argv { "lint"; "--root"; "."; "Spec.pkl"; "Test.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // doctor: ENV-DEPENDENT (which tools are on PATH, their versions, and their
  // absolute paths all vary by machine), so it is gated STRUCTURALLY, not at
  // byte parity. The EXIT CODE is also env-dependent (doctor exits 1 when a
  // required tool like `pkl` is absent — and CI does NOT install pkl, since the
  // evaluator is embedded), so exit is NOT gated. Assert only non-empty stdout
  // and the stable shape markers: the report banner, the four tool names, and
  // the `doctor:` summary. The volatile version/path bytes are never compared.
  new {
    id = "doctor-structural"
    fixture = "conformance/fixtures/empty"
    argv { "doctor" }
    contract = new {
      exit = false
      stdoutNonEmpty = true
      mustContain {
        "pkspec doctor"
        "environment check"
        "pkl"
        "git"
        "node"
        "go"
        "doctor:"
      }
    }
  }
  // doctor --json: the machine report. ENV-dependent values, so assert only the
  // stable JSON shape — the `checks` array wrapper and the four tool names plus
  // the `required` / `level` keys. (A deep-equal `json=true` contract would
  // break on the volatile path/version fields, so this uses mustContain on the
  // stable structural tokens instead.)
  new {
    id = "doctor-json-structural"
    fixture = "conformance/fixtures/empty"
    argv { "doctor"; "--json" }
    contract = new {
      exit = false
      stdoutNonEmpty = true
      mustContain {
        "\"checks\""
        "\"name\""
        "\"required\""
        "\"level\""
        "\"pkl\""
      }
    }
  }
  // unknown command: Go returns an error from run(), which main() prints and
  // exits 1 with (NOT 2). The usage banner is MoonBit-native (P0), so assert
  // only the stable `unknown command` marker on stderr + exit 1 + empty stdout.
  new {
    id = "unknown-command"
    fixture = "conformance/fixtures/empty"
    argv { "definitely-not-a-command" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr { "unknown command" }
    }
  }
  // ── P3a: exec (shell `cmd` executor) ────────────────────────────────
  //
  // exec is oracle CLASS 2 (dynamic execution): the progress + summary go to
  // STDERR and embed the per-test wall-clock DURATION. These scenarios gate the
  // normalized stderr stream at byte parity (`exactStderr` + `normalizeDurations`
  // replaces every `(<num><unit>)` with `(DUR)` on both sides), with stdout
  // asserted empty (cmd output is captured + asserted, not echoed). Only pure-
  // `cmd` deterministic fixtures are used so no deferred feature (steps /
  // parallel / background / http / retries / property) affects the result.
  //
  // exec-shell-smoke: one `echo pong` CmdTest with an inline-snapshot assert →
  // passes, exit 0. Vendored copy of examples/shell-smoke.
  new {
    id = "exec-shell-smoke"
    fixture = "conformance/fixtures/exec-shell-smoke"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-shell-smoke" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-stdout-contract: a cmd-only subset of examples/shell-output-contract —
  // the top-level CmdTest exercising contains / regex / JSONPath stream asserts
  // on a fixed JSON line → passes, exit 0. (The fixture's steps test is dropped;
  // steps are a P3b body.)
  new {
    id = "exec-stdout-contract"
    fixture = "conformance/fixtures/exec-stdout-contract"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-stdout-contract" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-fail: `false` against expectExitCode 0 → the test fails with
  // `expected exit code 0, got 1`, the tally is red, and exec exits 1 plus the
  // trailing `pkspec: N test(s) failed ...` line. Regression for the failure-
  // reason wording + the non-green exit semantics (Go Tally.IsGreen false).
  new {
    id = "exec-fail"
    fixture = "conformance/fixtures/exec-fail"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-fail" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // ── P3b: exec steps / parallelSteps / background / hooks ──────────────
  //
  // Same oracle CLASS 2 gating as the P3a exec scenarios. The DETERMINISTIC
  // shell-only fixtures (steps-contract / steps-capture / parallel-steps) gate
  // the normalized stderr at byte parity (exactStderr + normalizeDurations).
  // The VOLATILE fixtures (hooks-lifecycle uses `date +%s` / `$RANDOM`;
  // background-shell allocates a non-deterministic TCP port) gate via exit +
  // mustContainStderr on the stable outcome / summary markers ONLY — their
  // per-line ports / random tokens must NOT be byte-compared.

  // exec-steps-contract: examples/shell-output-contract verbatim — a top-level
  // CmdTest + a SequentialTest step, both passing (contains / regex(`(?m)`) /
  // JSONPath asserts). Tests are name-sorted, so `step_stdout_contract` prints
  // before `top_level_stdout_contract`. Passing steps stay silent. exit 0.
  new {
    id = "exec-steps-contract"
    fixture = "conformance/fixtures/exec-steps-contract"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-steps-contract" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-steps-capture: examples/shell-steps-capture verbatim — two sequential
  // steps where step 1 `captureStdout = EVENT_ID` and step 2 interpolates
  // `$EVENT_ID` (deterministic `echo`, so the captured value is stable). The
  // step-2 empty inlineStdout snapshot mismatches its actual stdout, so the
  // test FAILS deterministically: this gates the capture-propagation +
  // skip/step-line + first-failure-reason wording. exit 1.
  new {
    id = "exec-steps-capture"
    fixture = "conformance/fixtures/exec-steps-capture"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-steps-capture" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-parallel-steps: examples/parallel-steps verbatim — a SequentialTest and
  // a ParallelTest, each 3 sleeps, both passing. Passing steps print no per-step
  // line, so the concurrent finish ORDER never reaches stderr; the only stderr
  // is the two name-sorted (`parallel` before `sequential`) test lines + the
  // summary, which is fully deterministic. exit 0.
  new {
    id = "exec-parallel-steps"
    fixture = "conformance/fixtures/exec-parallel-steps"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-parallel-steps" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-hooks-lifecycle: examples/hooks-lifecycle verbatim — before("all")
  // captures $SEED, before("each") captures $PER_TEST, after("all") alwaysRun.
  // The hook cmds embed `date +%s` / `$RANDOM`, so the captured values are
  // VOLATILE → no exactStderr. Gate exit 1 (the empty inline snapshots
  // mismatch) + mustContainStderr on the stable structure: both tests fail with
  // the inlineStdout-mismatch reason carrying the propagated `SEED=seed-` value,
  // and the red summary. This proves the hook capture + before/after wiring.
  new {
    id = "exec-hooks-lifecycle"
    fixture = "conformance/fixtures/exec-hooks-lifecycle"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-hooks-lifecycle" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr {
        "[pkspec] alpha: failed (verifies runner.hooks.lifecycle)"
        "[pkspec] beta: failed (verifies runner.hooks.lifecycle)"
        "inlineStdout mismatch:"
        "actual: \"SEED=seed-"
        "PER_TEST=seed-"
        "pkspec: 0 passed, 0 flaky, 0 pending, 2 failed, 0 errored, 0 skipped (of 2)"
        "pkspec: 2 test(s) failed, 0 errored, 0 skipped"
      }
    }
  }
  // exec-background-shell: examples/background-shell verbatim — a shell-only
  // background with portEnv (a free TCP port, NON-DETERMINISTIC) +
  // readyStdoutMatches, then a step asserting `$BG_PORT` is numeric. The test
  // PASSES (the background spawns, becomes ready, the body sees the port, then
  // SIGTERM/grace/SIGKILL tears it down). Ports / pids are volatile → no
  // exactStderr; gate exit 0 + mustContainStderr on the passing test line +
  // green summary. This proves the start → ready → body → kill lifecycle.
  new {
    id = "exec-background-shell"
    fixture = "conformance/fixtures/exec-background-shell"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-background-shell" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      mustContainStderr {
        "[pkspec] background_shell_lifecycle: passed (verifies parallel.background)"
        "pkspec: 1 passed, 0 flaky, 0 pending, 0 failed, 0 errored, 0 skipped (of 1)"
      }
    }
  }
  // ── P3c: exec retries/flaky + reference snapshots + eventually/repeat + JUnit ──
  //
  // Same oracle CLASS 2 gating as the P3a/b exec scenarios. The DETERMINISTIC
  // fixtures (retry-flaky / snapshot-match / eventually) gate the normalized
  // stderr at byte parity (exactStderr + normalizeDurations) — each is made
  // deterministic with an in-work-dir counter file (retry / eventually) or a
  // committed snapshot (snapshot-match). The snapshot-WRITE + JUnit fixtures
  // create files, so they additionally gate fsDelta; the snapshot-write reason
  // carries the per-run ABSOLUTE snapshot path, so it gates mustContainStderr on
  // the stable prefix (not exactStderr).

  // exec-retry-flaky: `retries = 1` + `flakyAcceptable = true`; the cmd reads +
  // increments a `.attempt` counter file, failing the 1st attempt (count 0) and
  // passing the 2nd (count 1). Deterministically Flaky → exit 0, with the stable
  // `[1/2 attempts passed]` suffix on the progress line. Gates the retry loop +
  // classify + the attempt-count format.
  new {
    id = "exec-retry-flaky"
    fixture = "conformance/fixtures/exec-retry-flaky"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-retry-flaky" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-snapshot-match: the committed `.pkspec/snapshots/match_out.bytes` (raw
  // "snapshot-line\n") equals the cmd stdout, so the test PASSES, exit 0. Gates
  // the snapshot read + byte-exact compare via exact stderr.
  new {
    id = "exec-snapshot-match"
    fixture = "conformance/fixtures/exec-snapshot-match"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-snapshot-match" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // exec-snapshot-write: NO committed snapshot, so the first run writes
  // `.pkspec/snapshots/fresh_out.bytes` from this test's stdout and FAILS, exit
  // 1. The wrote-initial reason carries the per-run ABSOLUTE snapshot path (the
  // temp work dir), so it is NOT byte-stable → gate exit + the created-file
  // fsDelta + mustContainStderr on the stable prefix (no abs path).
  new {
    id = "exec-snapshot-write"
    fixture = "conformance/fixtures/exec-snapshot-write"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-snapshot-write" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      fsDelta = true
      mustContainStderr {
        "[pkspec] snapshot_writes_initial: failed (verifies diff.reference-snapshot)"
        "stdout snapshot \"fresh_out\": wrote initial from this test's output — review and commit"
        "pkspec: 0 passed, 0 flaky, 0 pending, 1 failed, 0 errored, 0 skipped (of 1)"
        "pkspec: 1 test(s) failed, 0 errored, 0 skipped"
      }
    }
  }
  // exec-eventually: an `eventually` step polls a `.poll` counter to pass on the
  // 2nd poll (intervalMs=50/timeoutSec=5, converges in-budget) followed by a
  // `repeat = 3` shell step. A passing eventually returns the attempt unchanged
  // (no `eventually:` reason) and passing steps stay silent, so the stderr is
  // fully deterministic → exit 0 + exact stderr. Gates the eventually poll-to-
  // pass + the repeat loop.
  new {
    id = "exec-eventually"
    fixture = "conformance/fixtures/exec-eventually"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-eventually" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
