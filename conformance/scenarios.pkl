  // P4c exec-timings-record: a DEFAULT `exec` run (recording ON) over two fast
  // `true` shell tests appends two pass records to a freshly-created
  // .pkspec/timings.jsonl. The record content (ts + duration_ms are volatile)
  // is gated byte-for-byte by the all-examples sweep, NOT here; this scenario
  // gates that the FILE is created (fsDelta on .pkspec/timings.jsonl) + the
  // run's exit 0 + the normalized progress/summary (exactStderr +
  // normalizeDurations). PASSES, exit 0.
  new {
    id = "exec-timings-record"
    fixture = "conformance/fixtures/exec-timings-record"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-timings-record" }
    argv { "exec"; "-f"; "Test.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      fsDelta = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // ── P4d: QuickCheck property-based iteration (xorshift32 + inputs) ────
  //
  // Both fixtures are DETERMINISTIC: a fixed `iterationSeed` pins the
  // xorshift32 stream, so the generated values, the failing-iteration seed, and
  // the shrink trace are fully reproducible. They gate the normalized stderr at
  // byte parity (exactStderr + normalizeDurations) with stdout asserted empty
  // (the property bodies capture/assert their own output; only the failing
  // body's `echo` would surface, and it exits 1 before any pass-through). The
  // goldens are captured from the Go oracle, whose xorshift32Step +
  // generateInputs + shrinkInputs the MoonBit port reproduces bit-for-bit.
  //
  // EXCLUDED (Gap B — cannot eval under the embedded loader): quickcheck-pkl/
  //   SortProperty.test.pkl (`Cannot find property \`length\` in object of type
  //   \`Int\``, a `pkl test` facts module, not an exec target).
  //
  // quickcheck-subprocess: examples/quickcheck-subprocess verbatim — the
  // seed-only `addition_is_associative` property (50 iterations, derives 3 ints
  // from $PKSPEC_SEED, checks integer-add associativity) PASSES; the two
  // deliberately-failing demos stay `pending`. Gates the all-pass seed-only
  // path + the `[N/N attempts passed]` accounting. exit 0.
  new {
    id = "quickcheck-subprocess"
    fixture = "conformance/fixtures/quickcheck-subprocess"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/quickcheck-subprocess" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // quickcheck-input-space: HAND-AUTHORED (not a verbatim example copy) so the
  // deterministic FAILING + shrink path is gated — the strongest PRNG + shrink
  // parity check. `addition_in_range` passes (30 iterations, A,B ∈ [0,100]);
  // `multiplication_bounded` fails at iteration 0 (A=10,B=17 from seed 1234567,
  // product 170 ≥ 100) and the greedy shrinker narrows to {A=7,B=15} in 5 steps.
  // The whole shrink trace is byte-compared. The run FAILS, exit 1.
  new {
    id = "quickcheck-input-space"
    fixture = "conformance/fixtures/quickcheck-input-space"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/quickcheck-input-space" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }
  // quickcheck-seed-wide: regression for the full-uint32 iterationSeed range.
  // `iterationSeed = 4294967295` (2^32-1) lives in the upper half [2^31, 2^32-1]
  // that the original `iteration_seed : Int` decode SILENTLY CLAMPED to
  // Int.MAX_VALUE — yielding the wrong xorshift32 stream (A=309 / seed=2147483647
  // instead of A=619 / seed=4294967295). Carrying the seed as Int64 fixes it;
  // this fixture gates the generated A (619) + the full 16-step shrink trace +
  // the `seed=4294967295` line byte-for-byte against the oracle, so a re-clamp
  // can't slip through. FAILS deterministically, exit 1.
  new {
    id = "quickcheck-seed-wide"
    fixture = "conformance/fixtures/quickcheck-seed-wide"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/quickcheck-seed-wide" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }

  // P4e expectAi: AI/LLM-judge assertions, exercised hermetically with a
  // DETERMINISTIC MOCK judge (a fixed shell rule over stdin + $PKSPEC_AI_PROMPT
  // — no LLM, no network). All three gate exactStderr + exit + normalizeDurations
  // (the judge verdict / explanation surfaces on stderr via the per-step
  // reasons). fsDelta is intentionally NOT gated: a live judge run writes
  // `.pkspec/ai-snapshots/<name>.json` (+ a `.lock` file) with a fixed
  // `updated_at`, which the contract neither asserts nor normalizes.
  //
  // exec-ai-pass: the mock judge greps the body (on stdin) for "hello"; the
  // body is `hello world`, so it exits 0 and the step PASSES. preferDeterministic
  // = false forces the judge to run.
  new {
    id = "exec-ai-pass"
    fixture = "conformance/fixtures/exec-ai-pass"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-ai-pass" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }

  // exec-ai-fail: the mock judge greps for "hello"; the body is `goodbye`, so it
  // prints an explanation to stderr and exits 1. The step FAILS with the reason
  // `ai: no greeting found` (the judge's explanation). FAILS deterministically,
  // exit 1.
  new {
    id = "exec-ai-fail"
    fixture = "conformance/fixtures/exec-ai-fail"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-ai-fail" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }

  // exec-ai-cache: the fixture ships a COMMITTED snapshot whose hash matches
  // sha256(prompt + "\n" + body); the runner finds it (no --refresh-ai) and
  // returns the cached `fail` verdict WITHOUT running the judge cmd (`exit 1`, a
  // tripwire). The step fails with `ai (cached): cached judgement: not a
  // greeting`, exercising the cache-hit path AND the `(cached)` indicator. exit
  // 1.
  new {
    id = "exec-ai-cache"
    fixture = "conformance/fixtures/exec-ai-cache"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/exec-ai-cache" }
    argv { "exec"; "-f"; "Test.pkl"; "--no-record-timings" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
      normalizeDurations = true
    }
  }

  // ── P5a: migrate (v0.1.x/v0.2.x → v0.3.0 Pkl text-transform) ──────────────
  //
  // The fixtures are plain v0.1.x/v0.2.x Pkl modules (no schema vendoring — the
  // transform is text-only and never evaluates Pkl). The goldens are captured
  // from the Go oracle. exactStdout here is the conformance harness's
  // whitespace-normalized compare; the load-bearing byte-for-byte parity vs the
  // oracle (indentation + newlines) is asserted by the P5a all-fixture sweep
  // (migrate --dry-run candidate-vs-oracle, 0 byte divergences) recorded in the
  // phase report — the committed golden is the regression backstop.

  // migrate-rules-all --dry-run: one module exercising every rule (1-7) and
  // every Step/Test body kind (ShellBody / CmdTest / SequentialTest /
  // ParallelTest / HttpBody / impl-Step) in combination. Gates the transformed
  // Pkl on stdout.
  new {
    id = "migrate-dry-run-rules-all"
    fixture = "conformance/fixtures/migrate-rules-all"
    argv { "migrate"; "--dry-run"; "Spec.pkl" }
    contract = new {
      exit = true
      exactStdout = true
    }
  }
  // migrate-notes --dry-run: the multi-line-block Note path (Rule 6 multi-line
  // expect block). Gates BOTH the transformed stdout (unchanged passthrough) and
  // the advisory Note + summary on stderr. The Note's path is the relative
  // `Spec.pkl` (stable across runs), so exactStderr is safe.
  new {
    id = "migrate-dry-run-notes"
    fixture = "conformance/fixtures/migrate-notes"
    argv { "migrate"; "--dry-run"; "Spec.pkl" }
    contract = new {
      exit = true
      exactStdout = true
      exactStderr = true
    }
  }
  // migrate --check on a STALE (would-change) file -> exit 1 (CI gate).
  new {
    id = "migrate-check-stale"
    fixture = "conformance/fixtures/migrate-rules-all"
    argv { "migrate"; "--check"; "Spec.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
    }
  }
  // migrate --check on an ALREADY-MIGRATED file -> exit 0 (idempotence). The
  // fixture is in the v0.3.0 shape, so the transform is a no-op.
  new {
    id = "migrate-check-clean"
    fixture = "conformance/fixtures/migrate-idempotent"
    argv { "migrate"; "--check"; "Spec.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
    }
  }
  // migrate (default in-place) on the rules-all fixture: atomically rewrites the
  // changed file. Gates the fs delta (Spec.pkl modified) + the `rewrote` /
  // summary lines on stderr.
  new {
    id = "migrate-in-place"
    fixture = "conformance/fixtures/migrate-rules-all"
    argv { "migrate"; "Spec.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      fsDelta = true
      exactStderr = true
    }
  }
  // migrate (default in-place) on the already-migrated fixture: no file changes
  // (idempotence), no fsDelta, only the scan summary on stderr.
  new {
    id = "migrate-in-place-clean"
    fixture = "conformance/fixtures/migrate-idempotent"
    argv { "migrate"; "Spec.pkl" }
    contract = new {
      exit = true
      stdoutEmpty = true
      exactStderr = true
    }
  }
  // adapter (mock protocol smoke): the hermetic gate for the `adapter` command
  // + the pkspec.adapter.v1 wire format. The adapter is a bash
  // `scripts/mock-adapter.sh` that speaks discover / run / coverage with FIXED
  // JSON (no external test runner), so this is fully deterministic and needs
  // nothing on PATH but bash. Gates exit + the stdout summary/coverage lines +
  // the stderr suite line, all at byte parity (no volatile tokens to
  // normalize). Goldens are captured from the Go oracle. The go-test /
  // moon-test scenarios below additionally exercise the LIVE toolchain.
  //
  // adapter (go-test live): a deterministic CI gate. The shim spawns the `go`
  // toolchain (discover via `go test -list`, run via `go test`), whose
  // persistent build-cache helper inherits the captured stdout pipe; the shim
  // therefore captures its child's stdout/stderr to FILES (not pipes it reads
  // to EOF) and waits on PROCESS EXIT, which clears the nested-capture hang the
  // earlier P5b draft hit. The fixture is a self-contained two-test go module
  // (`-count 1` defeats the build cache), so the adapter command's stdout is a
  // stable outcome summary with no volatile tokens (durations live only in the
  // shim's raw JSONL, which the command aggregates away). `go` is present on
  // the conformance runner. Goldens captured from the Go oracle.
  new {
    id = "adapter-go-test"
    fixture = "conformance/fixtures/adapter-go-test"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/adapter-go-test" }
    argv { "adapter"; "-f"; "Adapter.pkl" }
    contract = new {
      exit = true
      exactStdout = true
      exactStderr = true
    }
  }
  // adapter (moon-test live): the same deterministic CI gate for the moon-test
  // shim, against a TINY self-contained MoonBit package (NOT pkspec itself) so
  // `moon test` is fast + reproducible. Same file-redirect capture clears the
  // hang. `moon` is present on the conformance runner. Goldens from the oracle.
  new {
    id = "adapter-moon-test"
    fixture = "conformance/fixtures/adapter-moon-test"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/adapter-moon-test" }
    argv { "adapter"; "-f"; "Adapter.pkl" }
    contract = new {
      exit = true
      exactStdout = true
      exactStderr = true
    }
  }
  // vitest / node-test / playwright are still NOT gated: they need Node +
  // browsers (non-hermetic, excluded like doctor / run). Their file-scan
  // discover IS byte-verified vs the Go oracle in isolation, and the
  // file-redirect capture clears the run hang locally when Node is present
  // (see the P5b report); determinism (not the hang) is the reason they stay
  // ungated.
  new {
    id = "adapter-protocol-smoke"
    fixture = "conformance/fixtures/adapter-protocol-smoke"
    env { ["PKF_CONFORMANCE_SUBDIR"] = "examples/adapter-protocol-smoke" }
    argv { "adapter"; "-f"; "Adapter.pkl" }
    contract = new {
      exit = true
      exactStdout = true
      exactStderr = true
    }
  }
}
