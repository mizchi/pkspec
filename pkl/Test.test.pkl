/// Schema-level tests for `Test.pkl`. Run with `pkl test pkl/Test.test.pkl`.
amends "pkl:test"

import "Test.pkl" as Schema

local tcp: Schema.Test = new {
  name = "tcp"
  cmd = "curl -fsS http://localhost:8080/health"
  expectExitCode = 0
  expectStdout = "ok\n"
}

facts {
  ["name and cmd are preserved"] {
    tcp.name == "tcp"
    tcp.cmd == "curl -fsS http://localhost:8080/health"
  }
  ["defaults: shell is bash, exit code is 0, timeout is 60s"] {
    tcp.shell == "bash"
    tcp.expectExitCode == 0
    tcp.timeoutSec == 60
  }
  ["empty cmd is rejected"] {
    module.catch(() -> (new Schema.Test { name = "x"; cmd = "" }).cmd) != null
  }
  ["empty / whitespace-surrounded / multi-line names are rejected"] {
    // DisplayName disallows empty, leading/trailing space, and embedded newlines.
    module.catch(() -> (new Schema.Test { name = ""; cmd = "x" }).name) != null
    module.catch(() -> (new Schema.Test { name = " leading-space"; cmd = "x" }).name) != null
    module.catch(() -> (new Schema.Test { name = "trailing-space "; cmd = "x" }).name) != null
    module.catch(() -> (new Schema.Test { name = "two\nlines"; cmd = "x" }).name) != null
  }
  ["prose / punctuation / non-ASCII names are accepted"] {
    (new Schema.Test { name = "Float Power, IntDivide and Modulo semantics"; cmd = "x" }).name
      == "Float Power, IntDivide and Modulo semantics"
    (new Schema.Test { name = "is this consistent?"; cmd = "x" }).name == "is this consistent?"
    (new Schema.Test { name = "日本語 OK"; cmd = "x" }).name == "日本語 OK"
    (new Schema.Test { name = "-leading-dash"; cmd = "x" }).name == "-leading-dash"
  }
  ["non-positive timeout is rejected"] {
    module.catch(() -> (new Schema.Test { name = "x"; cmd = "x"; timeoutSec = 0 }).timeoutSec)
      != null
  }
  ["iteration seed must stay in uint32 range"] {
    module.catch(() -> (new Schema.Test { name = "x"; cmd = "x"; iterationSeed = -1 }).iterationSeed)
      != null
    module.catch(() ->
      (new Schema.Test { name = "x"; cmd = "x"; iterationSeed = 4294967296 }).iterationSeed
    ) != null
  }
}

examples {
  ["minimal Test"] {
    tcp
  }
}
