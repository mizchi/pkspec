    }
  }
  new {
    id = "adapter.examples"
    name = "adapter_examples_cover_builtin_and_external_runners"
    description = "Examples cover Vitest, Playwright, node:test, go test, moon test, an arbitrary external protocol adapter, and a runnable protocol smoke adapter. Schema examples validate with `pkl eval`; the smoke example runs with `pkspec adapter`."
    tags { "spec" }
    severity = "minor"
