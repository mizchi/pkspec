/// pkspec's own spec — dogfooded.
///
/// Lives at the repo root as `SPEC.pkl` — `pkspec spec --check`
/// with no path argument discovers it via the convention.
///
/// Every scenario is `tags { "spec" }` with no body, so the runner
/// reports them as pending. Implementations come in two shapes:
///   - "test" scenarios — verified by an `examples/*/Test.pkl` that
///     declares matching `specRef`.
///   - "code" / "doc" scenarios — verified by Go source or by a
///     reviewed doc; `implementedBy + implementedAt` are the
///     pointer. `--check` accepts them without a Pkl Test.
///
/// `pkspec spec --check --discover` is the canonical invocation:
/// the root SPEC.pkl plus auto-discovered examples.
///
/// ── ID naming convention ────────────────────────────────────
///
/// Both Scenario.id and Goal.id are dot-separated paths from a
/// short domain (`runner` / `kind` / `spec` / `parallel` /
/// `history` / `pbt` / `diff` / `ai` for scenarios; `goal` for
/// Goals) to a specific aspect. Two or three levels is typical:
///
///   runner.exit-code.pkspec-run
///   kind.http
///   spec.cross-reference
///   goal.ci-trustworthy
///
/// Reads independently of the spec body and survives
/// re-ordering — there is no global numeric sequence to keep
/// in sync.
amends "pkl/Spec.pkl"

feature = "pkspec — language-agnostic Pkl-based spec & test runner"

// ── Goals ───────────────────────────────────────────────────────────

goals {
  new Goal {
    id = "goal.ci-trustworthy"
    name = "CI gets a trustworthy exit code"
    priority = 95
    reviewStatus = "approved"
    description = "Any test failure surfaces as a non-zero exit. pkl test's silent-zero-on-failure gap is closed."
    rationale = "Without this, no other feature matters — a green CI lying about a red suite poisons every downstream decision."
  }
  new Goal {
    id = "goal.lang-independent"
    name = "tests are language-agnostic"
    priority = 90
    reviewStatus = "approved"
    description = "Authoring happens in Pkl, execution dispatches to per-kind Go executors. A new test kind = a Pkl class + a Go file."
    rationale = "Bash chains and per-ecosystem runners both break at the seams of cross-language projects. The schema lives above the language."
  }
  new Goal {
    id = "goal.spec-driven"
    name = "specs and tests cross-reference"
    priority = 85
    reviewStatus = "approved"
    description = "Specs are first-class Pkl values with stable ids, lifecycle, and a knowledge graph. Tests declare which specs they verify."
    rationale = "Without traceability, specs rot into design-doc folklore and tests become orphaned artefacts. Cross-references are the load-bearing edge."
  }
  new Goal {
    id = "goal.parallel-execution"
    name = "tests run in parallel where possible"
    priority = 70
    reviewStatus = "approved"
    description = "Within a test (parallelSteps), background-and-poll patterns (readyProbe), and across the test set (--shard)."
    rationale = "Sequential CI wall-clock is a productivity tax; the framework should hide the orchestration."
  }
  new Goal {
    id = "goal.history-aware"
    name = "the runner learns from previous runs"
    priority = 65
    reviewStatus = "approved"
    description = "Wall-clock history balances shards via LPT; the last-failed set is replayable; in-flight ctx-cancels become legible \"aborted by total-timeout\" outcomes."
    rationale = "Static configuration can't model real test costs. Recording observations and feeding them back is the only path to a balanced 4-machine matrix."
  }
  new Goal {
    id = "goal.property-based"
    name = "property-based + fuzzing first-class"
    priority = 50
    reviewStatus = "approved"
    description = "Test.iterations + Test.inputs (polymorphic Input schema), seed-deterministic generation, input-space shrinking on failure."
    rationale = "Examples cover known cases; properties cover the unknown ones. The framework should make both first-class so the gap between them is a choice, not friction."
  }
  new Goal {
    id = "goal.differential"
    name = "snapshot + differential testing"
    priority = 45
    reviewStatus = "approved"
    description = "Reference bytes are committed; ports of the same spec must produce identical output. Inline snapshots rewrite themselves on demand."
    rationale = "Cross-language ports without diff testing degenerate into folklore comparisons of half-remembered behaviour."
  }
  new Goal {
    id = "goal.ai-assertions"
    name = "natural-language assertions transition into code"
    priority = 30
    reviewStatus = "review"
    description = "expectAi delegates fuzzy claims to an LLM judge with content-hash caching, so the team can write the spec before the deterministic test exists."
    rationale = "Specs are often written before assertions can be made deterministic. The AI path is the placeholder, not the destination — `ai.prefer-deterministic` will surface coded checks once they exist."
  }
}

// ── Scenarios ───────────────────────────────────────────────────────

scenarios {

  // ── goal.ci-trustworthy ──────────────────────────────────────────

  new {
    id = "runner.exit-code.pkspec-run"
    name = "pkt_run_returns_nonzero_on_assertion_failure"
    description = "`pkspec run` wraps `pkl test` and forces a non-zero exit code when any test fails or any example writes a fresh snapshot — closing pkl test's silent-zero gap."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
    implementedBy = "code"
    implementedAt = "cmd/pkspec/main.go:cmdRun"
  }
  new {
    id = "runner.exec.assert-streams"
    name = "pkt_exec_asserts_exit_and_streams"
    description = "Each Test.cmd is run as a subprocess; expectExitCode, expectStdout / expectStderr (or inline equivalents) are checked literally."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
  }
  new {
    id = "runner.tally.is-green"
    name = "tally_is_green_only_when_nothing_is_red"
    description = "Tally.IsGreen returns true only when Failed == 0, Errored == 0, and Skipped == 0. Pending / flaky / passed do not block; timeout-skipped does."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:Tally.IsGreen"
  }
  new {
    id = "runner.junit-report"
    name = "junit_report_round_trips"
    description = "--junit-reports DIR writes JUnit XML matching the Tally; failures and errors are surfaced as `<failure>` and `<error>` so downstream CI dashboards work unchanged."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
  }

  // ── goal.lang-independent ────────────────────────────────────────

  new {
    id = "kind.shell"
    name = "shell_kind_dispatches_subprocesses"
    description = "Step.cmd runs in the configured shell with merged env / workdir / stdin and capture options."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.http"
    name = "http_kind_with_cassette_replay"
    description = "Step.http issues an HTTP request with body/headers/method; the `cassette` option records or replays the response so the test is deterministic offline."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.playwright"
    name = "playwright_kind_lightweight_harness"
    description = "Step.playwright drives a single page via the embedded Node harness; pixel-diff against ScreenshotSnapshot and expectConsole assertions land here."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.playwright-test"
    name = "playwrightTest_kind_wraps_external_runner"
    description = "Step.playwrightTest delegates to `@playwright/test` (fixtures, traces, retries) and round-trips the JUnit output back to pkspec's tally."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.sql"
    name = "sql_kind_with_embedded_sqlite"
    description = "Step.sql runs against modernc.org/sqlite (pure Go, no cgo). DML and parameterised queries are first-class."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.pluggable"
    name = "kind_is_pluggable_via_pkl_class_plus_go_executor"
    description = "Adding a new kind = a Pkl Spec class on Step + a `Step.kind` value + a Go function under internal/executor/. No core changes."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
    implementedBy = "doc"
    implementedAt = "docs/notes/runner-design.md"
  }

  // ── goal.spec-driven ─────────────────────────────────────────────

  new {
    id = "spec.auto-pending"
    name = "spec_tag_with_empty_body_auto_pending"
    description = "Test with `tags { \"spec\" }` and no cmd / steps / parallelSteps is reported as pending — written-down intent, no failure."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
  }
  new {
    id = "spec.cross-reference"
    name = "scenario_id_cross_references_test_specRef"
    description = "Scenario.id (in Spec.pkl) and Test.specRef (in Test.pkl) form the bidirectional cross-reference. The runner prints `(verifies <id>)` on each test line."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/spec.go:CheckUnimplemented"
  }
  new {
    id = "spec.lifecycle"
    name = "review_status_lifecycle"
    description = "draft → review → approved; deprecated retires a spec; replacedBy is the forwarding pointer. `--check` skips draft + deprecated."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "spec.cross-reference" }
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/spec.go:checkFromScenarios"
  }
  new {
    id = "spec.knowledge-graph"
    name = "knowledge_graph_edges"
    description = "dependsOn (precondition), supersedes (replaces a retired spec), parent (sub-spec refinement). `pkspec spec --graph` emits a graphviz `dot` document."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "spec.cross-reference" }
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/spec.go:Graph"
  }
  new {
    id = "spec.decision-log"
    name = "decision_log_is_append_only"
    description = "Each Scenario.decisions entry records date + author + summary + rationale. Append-only by convention; `pkspec spec --decisions` flattens newest-first."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/spec.go:DecisionLog"
  }
  new {
    id = "spec.goals"
    name = "goal_concept_with_priority"
    description = "Goals carry user-facing value statements with no test of their own. Scenarios point at Goals via `contributes`; `pkspec spec --next` ranks unimplemented specs by best Goal priority then severity."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "spec.cross-reference" }
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/spec.go:Goals"
  }
  new {
    id = "spec.prelude"
    name = "prelude_shares_given_across_scenarios"
    description = "Spec.pkl's top-level `prelude: Listing<SpecStep>` is prepended to every scenario's executed steps. Empty `given/when/then/cleanup` still auto-pends — shared setup doesn't count as having a body."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "pkl/Spec.pkl"
  }
  new {
    id = "spec.cli-modes"
    name = "pkt_spec_modes_cover_review_and_ci"
    description = "`pkspec spec` default renders SPEC.md; `--check / --coverage / --graph / --decisions / --goals / --next / --orphans` cover the review + CI surface. Filters: `--goal` / `--severity` / `--discover`."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "spec.cross-reference"; "spec.goals" }
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "cmd/pkspec/main.go:cmdSpec"
  }
  new {
    id = "spec.implemented-by"
    name = "framework_internal_specs_carry_implementation_pointer"
    description = "`Scenario.implementedBy = \"code\"` (or \"doc\") with `implementedAt = \"path:symbol\"` lets a Scenario claim implementation without a Pkl Test. `--check --strict` verifies the file part exists."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "spec.cross-reference" }
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/spec.go:scenarioIsImplemented"
  }
  new {
    id = "tooling.lint"
    name = "lint_catches_structural_authoring_mistakes"
    description = "`pkspec spec --lint` reports broken cross-references (dependsOn / supersedes / parent / replacedBy / contributes), missing descriptions on approved entries, critical specs with no Goal anchor, deprecated specs without replacedBy, future-dated decisions, and a few similar invariants. Error-level issues fail the command; warn / info are informational."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/lint.go:Lint"
  }
  new {
    id = "tooling.template"
    name = "template_skeleton_for_new_authoring"
    description = "`pkspec spec --template scenario|goal|module` prints a heavily-commented Pkl skeleton so authors don't start from a blank file. The module template includes the canonical amends + feature + goals + scenarios layout with placeholder ids."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "cmd/pkspec/spec_templates.go"
  }
  new {
    id = "tooling.authoring-guide"
    name = "step_by_step_authoring_walkthrough_exists"
    description = "A start-here doc walks new authors from empty directory to running `--check --lint --strict --discover` in roughly 15 minutes. Covers the Goal / Scenario / Test mental model, the dot-path id convention, lifecycle, graph edges, decision logs, framework-internal specs, and the CI single-line invocation."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "doc"
    implementedAt = "docs/notes/authoring-guide.md"
  }

  // ── goal.parallel-execution ──────────────────────────────────────

  new {
    id = "parallel.parallel-steps"
    name = "parallelSteps_run_concurrently"
    description = "Test.parallelSteps schedules every step concurrently (vs Steps' sequential order); first failure cancels in-flight peers."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.parallel-execution" }
  }
  new {
    id = "parallel.background"
    name = "background_with_readyProbe"
    description = "Background processes start before the test body, poll readyProbe until pass, are killed at test exit (pass or fail)."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.parallel-execution" }
  }
  new {
    id = "parallel.dynamic-port"
    name = "background_portEnv_for_dynamic_ports"
    description = "Background.portEnv asks the OS for a free TCP port and injects it into the test env so cmd / readyProbe / steps all see the same port."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "parallel.background" }
    contributes { "goal.parallel-execution" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:getFreePort"
  }

  // ── goal.history-aware ───────────────────────────────────────────

  new {
    id = "history.timings-jsonl"
    name = "timings_jsonl_records_per_test_durations"
    description = ".pkspec/timings.jsonl records {ts, test, duration_ms, outcome, env, kind} per test, env-bucketed via PKSPEC_TIMING_ENV."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.history-aware" }
  }
  new {
    id = "history.shard-lpt"
    name = "shard_K_of_N_via_LPT"
    description = "`pkspec exec --shard=K/N` splits the test set into N bins using Longest-Processing-Time bin-packing on the median of recent 5 history records. Tie-breaking is deterministic so the same input produces the same assignment across machines."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "history.timings-jsonl" }
    contributes { "goal.history-aware"; "goal.parallel-execution" }
  }
  new {
    id = "history.total-timeout"
    name = "total_timeout_aborts_cleanly"
    description = "`--total-timeout=DUR` wraps the run in context.WithTimeout; on expire, in-flight test errors with reason \"aborted by total-timeout\", remaining tests report Outcome=Skipped. Tally.IsGreen returns false."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.history-aware" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:Run"
  }
  new {
    id = "history.rerun-failed"
    name = "rerun_failed_replays_history"
    description = "`--rerun-failed` filters to tests whose most recent timings.jsonl record is fail / error / timeout / skip. Composes with --shard and --only/--tag."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "history.timings-jsonl" }
    contributes { "goal.history-aware" }
    implementedBy = "code"
    implementedAt = "cmd/pkspec/rerun.go:pickRerunFailed"
  }
  new {
    id = "history.timings-cli"
    name = "pkt_timings_inspection_subcommand"
    description = "`pkspec timings -f Test.pkl [--failing|--shard=K/N|--env NAME]` reports per-test runs/median/p90/latest/kind without running anything. `--shard=K/N` previews the assignment byte-for-byte."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "history.timings-jsonl"; "history.shard-lpt" }
    contributes { "goal.history-aware" }
    implementedBy = "code"
    implementedAt = "cmd/pkspec/timings_cmd.go"
  }

  // ── goal.property-based ──────────────────────────────────────────

  new {
    id = "pbt.iterations"
    name = "test_iterations_seed_based"
    description = "Test.iterations = N runs the body N times with seed-deterministic generation; the same seed reproduces the same trace."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.property-based" }
  }
  new {
    id = "pbt.inputs"
    name = "polymorphic_input_schema"
    description = "Test.inputs uses an abstract `Input` class with concrete subclasses (IntInput, ...). Each iteration projects fresh values via the seed stream."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "pbt.iterations" }
    contributes { "goal.property-based" }
  }
  new {
    id = "pbt.shrinking"
    name = "input_space_shrinking_on_failure"
    description = "On a failing iteration, the runner shrinks each input toward its lower bound / half / minus one, taking the smallest failing case as the report."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "pbt.inputs" }
    contributes { "goal.property-based" }
    implementedBy = "code"
    implementedAt = "internal/executor/inputs.go"
  }

  // ── goal.differential ────────────────────────────────────────────

  new {
    id = "diff.reference-snapshot"
    name = "reference_snapshot_files_committed"
    description = ".pkspec/snapshots/<name>.bytes is written on first run and committed; subsequent runs match against it. Mismatch writes a `.actual` sibling for diffing."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:checkSnapshot"
  }
  new {
    id = "diff.inline-snapshot"
    name = "inline_snapshot_rewrite"
    description = "inlineStdout / inlineStderr (Test + Step) and inlineHttpBody (Step on http kind) carry an in-source snapshot value. Mismatch on a regular run fails the step; `--update-inline-snapshots` rewrites the field in place with the captured value. The schema file itself is the snapshot artefact."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:ReplaceField"
  }
  new {
    id = "diff.inline-http-body"
    name = "inline_snapshot_of_http_response_body"
    description = "`Step.inlineHttpBody` is the http-kind sibling of `inlineStdout`. The captured response body is compared against the inline string; mismatch fails unless `--update-inline-snapshots` is set, in which case the field is rewritten in the Pkl source."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:runHttpStep"
  }
  new {
    id = "diff.inline-jsonpath"
    name = "inline_snapshot_per_jsonpath_subtree"
    description = "`Step.inlineJsonPath` is a `Mapping<String, String>` from JSONPath expression to the JSON-encoded captured subtree (gjson `.Raw` form). Each authored entry is compared against the live lookup; mismatch fails unless `--update-inline-snapshots` is set, in which case `inline.ReplaceMappingEntryValue` rewrites only the value of that entry. Authoring contract is opt-in per path: only keys the user has listed (with any placeholder value) are checked or updated, so a single `--update` run does not balloon every step's mapping."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:ReplaceMappingEntryValue"
  }
  new {
    id = "diff.inline-headers"
    name = "inline_snapshot_per_response_header"
    description = "`Step.inlineHeaders` is the same `Mapping<String, String>` shape as `inlineJsonPath` but keyed by HTTP header name. Header names use Go's case-insensitive lookup (`http.Header.Get`). Same per-key opt-in contract: only authored header names are checked or rewritten."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-jsonpath" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:runHttpStep"
  }
  new {
    id = "diff.inline-multiline"
    name = "inline_snapshot_uses_triple_quoted_for_multiline"
    description = "When the captured value would need ≥ 2 embedded newlines (and is ≥ 80 chars), or has ≥ 4 newlines, or a single line ≥ 120 chars, the rewriter emits a Pkl triple-quoted (`\"\"\"...\"\"\"`) literal instead of a single-line `\\n`-escaped one. Diff-readable; round-trips byte-for-byte."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:shouldUseTripleQuoted"
  }
  new {
    id = "diff.inline-concurrent-safety"
    name = "inline_rewriter_safe_under_concurrent_processes"
    description = "`inline.RewriteUnderLock` acquires a POSIX flock on `<module>.pkspec-lock` for the read-mutate-write triple, so two `pkspec exec --update-inline-snapshots` processes against the same module serialise instead of clobbering each other. The brace counter masks string interiors and `//` comments before scanning, so a literal `}` inside a Pkl string doesn't escape the enclosing object."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:RewriteUnderLock"
  }
  new {
    id = "diff.cross-language"
    name = "differential_via_specRef_to_reference"
    description = "ReferenceSnapshot.generator declares a Test that produces the canonical bytes; ports of the same spec assert byte-identical output."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.differential" }
  }

  // ── goal.ai-assertions ───────────────────────────────────────────

  new {
    id = "ai.expect-ai"
    name = "expectAi_natural_language_assertion"
    description = "Step.expectAi { prompt, cmd, snapshotName } delegates a fuzzy claim to an external judge command; verdict is cached by sha256(prompt + body)."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.ai-assertions" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go"
  }
  new {
    id = "ai.prefer-deterministic"
    name = "prefer_deterministic_over_ai"
    description = "When a step has both deterministic assertions (expectStatus / expectBodyEquals / expectBodyContains / expectBodyJsonPath / expectHeaderEquals / expectStatusBetween / inlineStdout / expectStdout / expectStderr) and expectAi, the AI judge is skipped — the deterministic checks have already passed by the time the AI phase would run. Set `expectAi.preferDeterministic = false` to restore the legacy behaviour where the judge always runs alongside deterministic checks."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "ai.expect-ai" }
    contributes { "goal.ai-assertions" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:stepHasDeterministicAssertion"
    decisions {
      new Decision {
        date = "2026-05-12"
        author = "mizchi"
        summary = "default to skipping the judge when deterministic asserts cover the case"
        rationale = "expectAi is a scaffold — write it while the spec is fuzzy, leave it in the source as living documentation, let deterministic expectations take over once the contract is concrete. The runner should make that graduation automatic, not require deleting the AI line."
      }
    }
  }
}
