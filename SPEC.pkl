  // ── goal.adapter-dsl ────────────────────────────────────────────

  new {
    id = "adapter.dsl"
    name = "adapter_protocol_is_pkl_data"
    description = "`pkl/Adapter.pkl` defines AdapterSuite, Adapter, Discover, Plan, Run, CaseOverlay, and AdapterCase as Pkl values. The rendered output contains command argv, protocol, data formats, batch hints, overlays, and explicit generated cases; no runner-specific Go registry is needed for authoring."
    tags { "spec" }
    severity = "major"
    reviewStatus = "review"
    contributes { "goal.adapter-dsl"; "goal.lang-independent" }
    implementations {
      new Implementation { kind = "code"; at = "pkl/Adapter.pkl" }
    }
  }
  new {
    id = "adapter.extends-builtins"
    name = "built_in_adapters_are_selected_with_extends"
    description = "Vitest, Playwright, node:test, go test, and moon test are exposed as Pkl adapter subclasses under `pkl/adapters/`. Projects specialize them with normal Pkl `extends` instead of selecting from a Go-side registry."
    tags { "spec" }
    severity = "major"
    reviewStatus = "review"
    dependsOn { "adapter.dsl" }
    contributes { "goal.adapter-dsl"; "goal.lang-independent" }
    implementations {
      new Implementation { kind = "code"; at = "pkl/adapters/Vitest.pkl" }
    }
  }
  new {
    id = "adapter.overlays-and-cases"
    name = "adapter_suites_support_overlays_and_explicit_cases"
    description = "`overlays` attach specRef/tags/pending/timeout to native runner-discovered cases, while `cases` lets pkspec own generated native test registration via sourceModule/exportName/params."
    tags { "spec" }
    severity = "major"
    reviewStatus = "review"
    dependsOn { "adapter.dsl" }
    contributes { "goal.adapter-dsl"; "goal.spec-driven" }
    implementations {
