  new {
    id = "tooling.lint"
    name = "lint_catches_structural_authoring_mistakes"
    description = "`pkspec lint` reports broken cross-references (dependsOn / supersedes / parent / replacedBy / contributes / active Test.specRef), deprecated Test.specRef links, missing descriptions on approved entries, critical specs with no Goal anchor, deprecated specs without replacedBy, future-dated decisions, and similar invariants. Error-level issues fail the command; warn / info are informational."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "internal/spec/lint.go:Lint"
  }
  new {
    id = "tooling.template"
    name = "template_skeleton_for_new_authoring"
    description = "`pkspec spec --template scenario|goal|module` prints a heavily-commented Pkl skeleton so authors don't start from a blank file. The module template includes the canonical amends + feature + goals + scenarios layout with placeholder ids."
    tags { "spec" }
    severity = "minor"
