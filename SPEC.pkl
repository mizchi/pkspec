  new {
    id = "spec.cli-modes"
    name = "pkt_spec_modes_cover_review_and_ci"
    description = "`pkspec spec` default renders developer SPEC.md; `pkspec docs --audience X` renders audience-specific docs; `pkspec check / coverage / graph / decisions / goals / milestones / next / implementations / orphans` cover the review + CI surface. Filters: `--goal` / `--severity` / `--discover`."
