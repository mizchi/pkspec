  new {
    id = "docs.audience-projection"
    name = "audience_specific_docs_projection"
    description = "`pkspec docs --audience <name>` filters scenarios by `audience { ... }` or `audience:<name>` tags and renders stable Markdown for a target reader. The projection hides runner implementation details by default while preserving scenario prose, Goals, open questions, and decisions for PM/developer profiles."
    pmNotes = "PM-facing docs can include product value, review status, open questions, and decisions without exposing shell commands or runner internals."
    userDescription = "A project can generate simpler documentation for different readers from the same written specs."
    tags { "spec"; "audience:pm"; "audience:end-user"; "audience:developer" }
    audience { "pm"; "end-user"; "developer"; "api"; "operator"; "non-engineer" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "spec.cli-modes"; "spec.goals" }
    contributes { "goal.spec-driven" }
    implementedBy = "code"
    implementedAt = "cmd/pkspec/main.go:cmdDocs"
  }
  new {
    id = "spec.implemented-by"
    name = "framework_internal_specs_carry_implementation_pointer"
    description = "`Scenario.implementedBy = \"code\"` (or \"doc\") with `implementedAt = \"path:symbol\"` lets a Scenario claim implementation without a Pkl Test. `pkspec check --strict` verifies the file part exists."
    tags { "spec" }
