    description = "`ReportCollector` attaches post-run report commands to an AdapterSuite. The first runnable format is `PkspecCoverageJson` with metrics `{name, covered, total}`; the CLI prints normalized coverage summaries independent of the source runner. Lcov and Cobertura are declared as future parser targets."
    tags { "spec" }
    severity = "major"
