  // ── goal.differential ────────────────────────────────────────────

  new {
    id = "diff.reference-snapshot"
    name = "reference_snapshot_files_committed"
    description = ".pkspec/snapshots/<name>.bytes is written on first run and committed; subsequent runs match against it. Mismatch writes a `.actual` sibling for diffing."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:checkSnapshot"
  }
  new {
    id = "diff.inline-snapshot"
    name = "inline_snapshot_rewrite"
    description = "inlineStdout / inlineStderr (Test + Step) and inlineHttpBody (Step on http kind) carry an in-source snapshot value. Mismatch on a regular run fails the step; `--update-inline-snapshots` rewrites the field in place with the captured value. The schema file itself is the snapshot artefact."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:ReplaceField"
  }
  new {
    id = "diff.inline-http-body"
    name = "inline_snapshot_of_http_response_body"
    description = "`Step.inlineHttpBody` is the http-kind sibling of `inlineStdout`. The captured response body is compared against the inline string; mismatch fails unless `--update-inline-snapshots` is set, in which case the field is rewritten in the Pkl source."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:runHttpStep"
  }
  new {
    id = "diff.inline-jsonpath"
    name = "inline_snapshot_per_jsonpath_subtree"
    description = "`Step.inlineJsonPath` is a `Mapping<String, String>` from JSONPath expression to the JSON-encoded captured subtree (gjson `.Raw` form). Each authored entry is compared against the live lookup; mismatch fails unless `--update-inline-snapshots` is set, in which case `inline.ReplaceMappingEntryValue` rewrites only the value of that entry. Authoring contract is opt-in per path: only keys the user has listed (with any placeholder value) are checked or updated, so a single `--update` run does not balloon every step's mapping."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:ReplaceMappingEntryValue"
  }
  new {
    id = "diff.inline-headers"
    name = "inline_snapshot_per_response_header"
    description = "`Step.inlineHeaders` is the same `Mapping<String, String>` shape as `inlineJsonPath` but keyed by HTTP header name. Header names use Go's case-insensitive lookup (`http.Header.Get`). Same per-key opt-in contract: only authored header names are checked or rewritten."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-jsonpath" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:runHttpStep"
  }
  new {
    id = "diff.inline-sql-rows"
    name = "inline_snapshot_per_jsonpath_against_sql_rows"
    description = "`Step.inlineSqlRows` is the sql-kind counterpart of `inlineJsonPath`. JSONPath is evaluated against the row-array JSON produced by a SQL kind step. Same per-key opt-in contract. Lives at Step level (not on SqlSpec) to reuse the existing single-level Mapping rewriter — consistent with `inlineHttpBody` which is also Step-level despite being http-only."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-jsonpath" }
    contributes { "goal.differential"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/executor/sql.go:runSqlStep"
  }
  new {
    id = "diff.inline-console-log"
    name = "inline_snapshot_of_playwright_console_stream"
    description = "`Step.inlineConsoleLog: String?` captures the playwright page's full console output as a newline-joined string. Same single-string contract as `inlineStdout` and `inlineHttpBody`: opt in by setting any string, mismatch fails, `--update-inline-snapshots` rewrites. Multi-line bodies are emitted as Pkl triple-quoted literals when long. Only takes effect for kind = \"playwright\"; ignored on other kinds."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/executor/playwright.go:runPlaywrightStep"
  }
  new {
    id = "diff.inline-multiline"
    name = "inline_snapshot_uses_triple_quoted_for_multiline"
    description = "When the captured value would need ≥ 2 embedded newlines (and is ≥ 80 chars), or has ≥ 4 newlines, or a single line ≥ 120 chars, the rewriter emits a Pkl triple-quoted (`\"\"\"...\"\"\"`) literal instead of a single-line `\\n`-escaped one. Diff-readable; round-trips byte-for-byte."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:shouldUseTripleQuoted"
  }
  new {
    id = "diff.inline-concurrent-safety"
    name = "inline_rewriter_safe_under_concurrent_processes"
    description = "`inline.RewriteUnderLock` acquires a POSIX flock on `<module>.pkspec-lock` for the read-mutate-write triple, so two `pkspec exec --update-inline-snapshots` processes against the same module serialise instead of clobbering each other. The brace counter masks string interiors and `//` comments before scanning, so a literal `}` inside a Pkl string doesn't escape the enclosing object."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "diff.inline-snapshot" }
    contributes { "goal.differential" }
    implementedBy = "code"
    implementedAt = "internal/inline/rewriter.go:RewriteUnderLock"
  }
  new {
    id = "diff.cross-language"
    name = "differential_via_specRef_to_reference"
    description = "ReferenceSnapshot.generator declares a Test that produces the canonical bytes; ports of the same spec assert byte-identical output."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.differential" }
  }

  // ── goal.ai-assertions ───────────────────────────────────────────

  new {
    id = "ai.expect-ai"
    name = "expectAi_natural_language_assertion"
    description = "Step.expectAi { prompt, cmd, snapshotName } delegates a fuzzy claim to an external judge command; verdict is cached by sha256(prompt + body)."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.ai-assertions" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go"
  }
  new {
    id = "ai.prefer-deterministic"
    name = "prefer_deterministic_over_ai"
    description = "When a step has both deterministic assertions (expectStatus / expectBodyEquals / expectBodyContains / expectBodyJsonPath / expectHeaderEquals / expectStatusBetween / inlineStdout / expectStdout / expectStderr) and expectAi, the AI judge is skipped — the deterministic checks have already passed by the time the AI phase would run. Set `expectAi.preferDeterministic = false` to restore the legacy behaviour where the judge always runs alongside deterministic checks."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "ai.expect-ai" }
    contributes { "goal.ai-assertions" }
    implementedBy = "code"
    implementedAt = "internal/executor/executor.go:stepHasDeterministicAssertion"
    decisions {
      new Decision {
        date = "2026-05-12"
        author = "mizchi"
        summary = "default to skipping the judge when deterministic asserts cover the case"
        rationale = "expectAi is a scaffold — write it while the spec is fuzzy, leave it in the source as living documentation, let deterministic expectations take over once the contract is concrete. The runner should make that graduation automatic, not require deleting the AI line."
      }
    }
  }
}
