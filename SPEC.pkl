    severity = "major"
    reviewStatus = "approved"
    dependsOn { "kind.playwright" }
    contributes { "goal.lang-independent"; "goal.ci-trustworthy" }
    implementedBy = "code"
    implementedAt = "internal/executor/playwright.go:checkConsole"
  }
  new {
    id = "kind.playwright-test"
    name = "playwrightTest_kind_wraps_external_runner"
    description = "Step.playwrightTest delegates to `@playwright/test` (fixtures, traces, retries) and round-trips the JUnit output back to pkspec's tally."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "runner.playwright-test.grep-filter"
    name = "playwright_test_grep_filter_is_forwarded"
    description = "PlaywrightTestSpec.grep is forwarded as `--grep` to @playwright/test so a pkspec step can run a focused subset of a suite."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "kind.playwright-test" }
    contributes { "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "internal/executor/playwrighttest.go:runPlaywrightTestStep"
  }
  new {
    id = "kind.sql"
    name = "sql_kind_with_embedded_sqlite"
    description = "Step.sql runs against modernc.org/sqlite (pure Go, no cgo). DML and parameterised queries are first-class."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.pluggable"
    name = "kind_is_pluggable_via_pkl_class_plus_go_executor"
    description = "Adding a new kind = a Pkl Spec class on Step + a `Step.kind` value + a Go function under internal/executor/. No core changes."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
    implementedBy = "doc"
    implementedAt = "docs/notes/runner-design.md"
  }

  // ── goal.adapter-dsl ────────────────────────────────────────────

  new {
    id = "adapter.dsl"
    name = "adapter_protocol_is_pkl_data"
    description = "`pkl/Adapter.pkl` defines AdapterSuite, Adapter, Discover, Plan, Run, CaseOverlay, and AdapterCase as Pkl values. The rendered output contains command argv, protocol, data formats, batch hints, overlays, and explicit generated cases; no runner-specific Go registry is needed for authoring."
    tags { "spec" }
    severity = "major"
    reviewStatus = "review"
    contributes { "goal.adapter-dsl"; "goal.lang-independent" }
    implementedBy = "code"
    implementedAt = "pkl/Adapter.pkl"
  }
  new {
    id = "adapter.extends-builtins"
