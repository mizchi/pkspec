/// pkspec's own spec — dogfooded.
///
/// Lives at the repo root as `SPEC.pkl` — `pkspec check`
/// with no path argument discovers it via the convention.
///
/// Every scenario is `tags { "spec" }` with no body, so the runner
/// reports them as pending. Implementations come in two shapes:
///   - "test" scenarios — verified by an `examples/*/Test.pkl` that
///     declares matching `specRef`.
///   - "code" / "doc" scenarios — verified by Go source or by a
///     reviewed doc; an `Implementation { kind = "code"|"doc"; at = ... }`
///     entry in `implementations` is the pointer. `pkspec check`
///     accepts them without a Pkl Test.
///
/// Canonical gate for pkspec itself:
///
///   pkspec check --strict SPEC.pkl examples/*/Test.pkl
///   pkspec lint SPEC.pkl examples/*/Spec.pkl examples/*/Test.pkl
///
/// Do not use `--discover` as the pkspec-own-spec gate. It also
/// sweeps example fixture specs such as `examples/spec-graph/Spec.pkl`
/// and `examples/spec-id/Spec.pkl`, which intentionally contain
/// unimplemented scenarios to demonstrate `pkspec check` / `pkspec next`.
///
/// ── ID naming convention ────────────────────────────────────
///
/// Both Scenario.id and Goal.id are dot-separated paths from a
/// short domain (`runner` / `kind` / `spec` / `parallel` /
/// `history` / `pbt` / `diff` / `ai` for scenarios; `goal` for
/// Goals) to a specific aspect. Two or three levels is typical:
///
///   runner.exit-code.pkspec-run
///   kind.http
///   spec.cross-reference
///   goal.ci-trustworthy
///
/// Reads independently of the spec body and survives
/// re-ordering — there is no global numeric sequence to keep
/// in sync.
amends "pkl/Spec.pkl"

feature = "pkspec — language-agnostic Pkl-based spec & test runner"

// ── Domain prefix allow-list ────────────────────────────────────────
//
// pkspec's own scenarios follow a strict dot-path convention with one
// of the 14 prefixes below. `pkspec lint` enforces this via the
// `lint.unknown-domain-prefix` info rule (opt-in: a project that does
// not declare `domains` gets zero new lint output). Update this list
// before introducing a new prefix so the lint and the convention move
// together.
domains {
  "adapter"; "ai"; "diff"; "docs"; "goal"; "history"; "kind"
  "ms"; "parallel"; "pbt"; "runner"; "security"; "spec"; "tooling"
}

// ── Goals ───────────────────────────────────────────────────────────

goals {
  new Goal {
    id = "goal.ci-trustworthy"
    name = "CI gets a trustworthy exit code"
    priority = 95
    reviewStatus = "approved"
    description = "Any test failure surfaces as a non-zero exit. pkl test's silent-zero-on-failure gap is closed."
    rationale = "Without this, no other feature matters — a green CI lying about a red suite poisons every downstream decision."
  }
  new Goal {
    id = "goal.secure-release"
    name = "release artifacts are hardened"
    priority = 88
    reviewStatus = "approved"
    description = "Published binaries, GitHub Actions, and schema-to-executor boundaries avoid known vulnerable toolchains, excess CI privileges, and unchecked numeric narrowing."
    rationale = "A test runner is part of the supply chain. Users should not have to audit every install path before trusting it in CI."
    progressMethod = "severity-weighted"
  }
  new Goal {
    id = "goal.lang-independent"
    name = "tests are language-agnostic"
    priority = 90
    reviewStatus = "approved"
    description = "Authoring happens in Pkl, execution dispatches to per-kind Go executors. A new test kind = a Pkl class + a Go file."
    rationale = "Bash chains and per-ecosystem runners both break at the seams of cross-language projects. The schema lives above the language."
  }
  new Goal {
    id = "goal.adapter-dsl"
    name = "native runners are adapter-defined"
    priority = 75
    reviewStatus = "review"
    description = "Whole native runners such as Vitest, Playwright, node:test, go test, and moon test are described by Pkl adapter modules instead of being hard-coded as Go executors."
    rationale = "pkspec cannot register every ecosystem runner in core. The extensibility point should be Pkl data plus a small process protocol."
  }
  new Goal {
    id = "goal.spec-driven"
    name = "specs and tests cross-reference"
    priority = 85
    reviewStatus = "approved"
    description = "Specs are first-class Pkl values with stable ids, lifecycle, and a knowledge graph. Tests declare which specs they verify."
    rationale = "Without traceability, specs rot into design-doc folklore and tests become orphaned artefacts. Cross-references are the load-bearing edge."
    progressMethod = "severity-weighted"
  }
  new Goal {
    id = "goal.parallel-execution"
    name = "tests run in parallel where possible"
    priority = 70
    reviewStatus = "approved"
    description = "Within a test (parallelSteps), background-and-poll patterns (readyProbe), and across the test set (--shard)."
    rationale = "Sequential CI wall-clock is a productivity tax; the framework should hide the orchestration."
  }
  new Goal {
    id = "goal.history-aware"
    name = "the runner learns from previous runs"
    priority = 65
    reviewStatus = "approved"
    description = "Wall-clock history balances shards via LPT; the last-failed set is replayable; in-flight ctx-cancels become legible \"aborted by total-timeout\" outcomes."
    rationale = "Static configuration can't model real test costs. Recording observations and feeding them back is the only path to a balanced 4-machine matrix."
  }
  new Goal {
    id = "goal.property-based"
    name = "property-based + fuzzing first-class"
    priority = 50
    reviewStatus = "approved"
    description = "Test.iterations + Test.inputs (polymorphic Input schema), seed-deterministic generation, input-space shrinking on failure."
    rationale = "Examples cover known cases; properties cover the unknown ones. The framework should make both first-class so the gap between them is a choice, not friction."
  }
  new Goal {
    id = "goal.differential"
    name = "snapshot + differential testing"
    priority = 45
    reviewStatus = "approved"
    description = "Reference bytes are committed; ports of the same spec must produce identical output. Inline snapshots rewrite themselves on demand."
    rationale = "Cross-language ports without diff testing degenerate into folklore comparisons of half-remembered behaviour."
  }
  new Goal {
    id = "goal.ai-assertions"
    name = "natural-language assertions transition into code"
    priority = 30
    reviewStatus = "review"
    description = "expectAi delegates fuzzy claims to an LLM judge with content-hash caching, so the team can write the spec before the deterministic test exists."
    rationale = "Specs are often written before assertions can be made deterministic. The AI path is the placeholder, not the destination — `ai.prefer-deterministic` will surface coded checks once they exist."
  }
}

// ── Milestones ──────────────────────────────────────────────────────

milestones {
  new Milestone {
    id = "ms.spec-authoring"
    name = "spec authoring review surface"
    reviewStatus = "review"
    description = "Goal, Scenario, docs, lint, and review commands form a usable authoring loop."
    goals { "goal.spec-driven" }
  }
  new Milestone {
    id = "ms.release-hardening"
    name = "release hardening baseline"
    reviewStatus = "review"
    description = "Toolchain, CI permissions, and trusted-input boundaries have explicit specs before the next patch release."
    goals { "goal.secure-release" }
  }
}

// ── Scenarios ───────────────────────────────────────────────────────

scenarios {

  // ── goal.ci-trustworthy ──────────────────────────────────────────

  new {
    id = "runner.exit-code.pkspec-run"
    name = "pkt_run_returns_nonzero_on_assertion_failure"
    description = "`pkspec run` wraps `pkl test` and forces a non-zero exit code when any test fails or any example writes a fresh snapshot — closing pkl test's silent-zero gap."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "cmd/pkspec/main.go:cmdRun" }
    }
  }
  new {
    id = "runner.exec.assert-streams"
    name = "pkt_exec_asserts_exit_and_streams"
    description = "Each Test.cmd is run as a subprocess; expectExitCode, expectStdout / expectStderr (or inline equivalents) are checked literally."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
  }
  new {
    id = "runner.tally.is-green"
    name = "tally_is_green_only_when_nothing_is_red"
    description = "Tally.IsGreen returns true only when Failed == 0, Errored == 0, and Skipped == 0. Pending / flaky / passed do not block; timeout-skipped does."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/executor.go:Tally.IsGreen" }
    }
  }
  new {
    id = "runner.junit-report"
    name = "junit_report_round_trips"
    description = "--junit-reports DIR writes JUnit XML matching the Tally; failures and errors are surfaced as `<failure>` and `<error>` so downstream CI dashboards work unchanged."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy" }
  }

  // -- goal.secure-release -----------------------------------------

  new {
    id = "security.go-toolchain-vulnerability-floor"
    name = "go_toolchain_has_no_known_reachable_vulnerabilities"
    description = "The Go module and Nix package use a patched Go toolchain so `govulncheck ./...` reports no known reachable vulnerabilities in pkspec or the standard library used by pkspec."
    tags { "spec"; "security"; "release"; "toolchain" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.secure-release"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "flake.nix:go_1_26_3" }
    }
    decisions {
      new Decision {
        date = "2026-05-14"
        author = "mizchi"
        summary = "pin Nix and Go module builds to Go 1.26.3 after govulncheck"
        rationale = "The vulnerability was in reachable standard-library paths, so relying on a local auto-downloaded toolchain was insufficient; release artifacts built by Nix also need the patched compiler/runtime."
      }
    }
  }
  new {
    id = "security.workflow-read-only-permissions"
    name = "non_release_workflows_are_read_only"
    description = "Non-release GitHub Actions workflows declare `permissions: contents: read`; only the tag publishing workflow keeps `contents: write` for GitHub Release publication."
    tags { "spec"; "security"; "ci"; "github-actions" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.secure-release"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = ".github/workflows/go.yml:permissions" }
    }
  }
  new {
    id = "security.govulncheck-weekly"
    name = "govulncheck_runs_weekly_in_ci"
    description = "A standalone GitHub Actions workflow runs `govulncheck ./...` on a weekly cron (Mondays 09:00 UTC) plus on every PR that touches go.mod / go.sum / flake.nix, so newly disclosed Go stdlib vulnerabilities surface without a manual sweep."
    tags { "spec"; "security"; "ci"; "github-actions" }
    severity = "major"
    reviewStatus = "review"
    contributes { "goal.secure-release" }
    implementations {
      new Implementation { kind = "code"; at = ".github/workflows/govulncheck.yml" }
    }
  }
  new {
    id = "security.dependabot-weekly"
    name = "dependabot_keeps_deps_current"
    description = "Dependabot is configured for gomod and github-actions ecosystems on a weekly cadence so Go module pins and workflow action versions do not drift silently."
    tags { "spec"; "security"; "ci"; "dependabot" }
    severity = "minor"
    reviewStatus = "review"
    contributes { "goal.secure-release" }
    implementations {
      new Implementation { kind = "code"; at = ".github/dependabot.yml" }
    }
  }
  new {
    id = "tooling.migrate"
    name = "migrate_command_text_transforms_v01_to_v02"
    description = "`pkspec migrate [--dry-run|--check] <path>...` is a text-only Pkl-source rewriter from the v0.1.x schema (implementedBy/implementedAt, userDescription/pmNotes/operatorNotes/apiNotes, GoalProgress) to v0.2.0 (Implementations Listing, audienceNotes Mapping, progressMethod). The transform never invokes Pkl eval — it works on sources that no longer parse under the current schema. Multiple audience-notes in one block consolidate into a single `audienceNotes { ... }` block. Idempotent."
    tags { "spec"; "tooling"; "migration" }
    severity = "major"
    reviewStatus = "review"
    contributes { "goal.spec-driven" }
    implementations {
      new Implementation { kind = "code"; at = "internal/migrate/migrate.go:MigrateV01ToV02" }
    }
  }
  new {
    id = "tooling.source-scan"
    name = "scan_extracts_pkspec_spec_markers"
    description = "`pkspec lint --scan PATH` and `pkspec graph --scan PATH` walk every file (or every supported-extension file inside a directory) for the marker `pkspec:spec=<id>` and yield SourceRef{specId, path, line} for downstream rules. node_modules / vendor / dist / build / .git are pruned. The id char class matches Scenario.id and cannot end with `.` so markers embedded in prose capture cleanly."
    tags { "spec"; "tooling"; "lint" }
    severity = "minor"
    reviewStatus = "review"
    contributes { "goal.spec-driven" }
    implementations {
      new Implementation { kind = "code"; at = "internal/spec/scan.go:ScanSources" }
    }
  }
  new {
    id = "tooling.dead-source-ref-lint"
    name = "lint_dead_source_specref_is_error"
    description = "When `pkspec lint --scan` finds a `pkspec:spec=<id>` marker whose id is not declared as any Scenario.id across the loaded plans, `lint.dead-source-specRef` fires at error level. Subject is `path:line` of the first occurrence; the message includes the occurrence count when the id is referenced from multiple lines."
    tags { "spec"; "tooling"; "lint" }
    severity = "major"
    reviewStatus = "review"
    dependsOn { "tooling.source-scan" }
    contributes { "goal.spec-driven"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "internal/spec/lint.go:LintWithSources" }
    }
  }
  new {
    id = "spec.graph-source-backlinks"
    name = "graph_includes_source_marker_backlinks"
    description = "`pkspec graph --scan PATH` emits a green-filled `src:<path>` node per source file carrying a `pkspec:spec=<id>` marker, plus one edge per (file, id) pair to the matching Scenario node. The edge label carries the occurrence count when one file references the same id multiple times."
    tags { "spec"; "tooling" }
    severity = "minor"
    reviewStatus = "review"
    dependsOn { "tooling.source-scan"; "spec.graph-implementation-links" }
    contributes { "goal.spec-driven" }
    implementations {
      new Implementation { kind = "code"; at = "internal/spec/spec.go:GraphWithSources" }
    }
  }
  new {
    id = "tooling.domain-lint"
    name = "lint_unknown_domain_prefix_is_opt_in"
    description = "When a Spec.pkl module declares the optional module-level `domains` allow-list, `pkspec lint` reports any Scenario.id whose first dot-segment is not in the list as `lint.unknown-domain-prefix` at info level. Modules that leave `domains` empty (e.g. `examples/*`) get no new lint output, so the rule is opt-in."
    tags { "spec"; "tooling"; "lint" }
    severity = "minor"
    reviewStatus = "review"
    contributes { "goal.spec-driven" }
    implementations {
      new Implementation { kind = "code"; at = "internal/spec/lint.go:Lint" }
    }
  }
  new {
    id = "tooling.ci-concurrency"
    name = "workflows_cancel_in_progress_runs"
    description = "Go / Action / Nix workflows declare `concurrency.cancel-in-progress = true` keyed by `(workflow, ref)` so rapid successive pushes to a branch leave only the latest commit's CI executing; older queued runs are auto-cancelled and the badge always reflects the latest commit."
    tags { "spec"; "ci"; "github-actions" }
    severity = "minor"
    reviewStatus = "review"
    contributes { "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = ".github/workflows/go.yml:concurrency" }
    }
  }

  // ── goal.lang-independent ────────────────────────────────────────

  new {
    id = "kind.shell"
    name = "shell_kind_dispatches_subprocesses"
    description = "Step.cmd runs in the configured shell with merged env / workdir / stdin and capture options."
    tags { "spec" }
    severity = "critical"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "runner.shell.stdout-patterns"
    name = "shell_stdout_stderr_contains_and_regex"
    description = "Top-level Test.cmd and shell Step.cmd support stdout/stderr substring and Go-regexp assertions, so CLI contracts do not need ad-hoc grep pipelines."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/executor.go:assertShellStream" }
    }
  }
  new {
    id = "runner.shell.stdout-jsonpath"
    name = "shell_stdout_stderr_jsonpath"
    description = "Top-level Test.cmd and shell Step.cmd support JSONPath assertions against stdout/stderr when the stream is valid JSON, matching the HTTP body JSONPath authoring model."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "runner.shell.stdout-patterns" }
    contributes { "goal.lang-independent"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/executor.go:assertShellStream" }
    }
  }
  new {
    id = "runner.shell.capture-stdout"
    name = "sequential_shell_steps_capture_stdout"
    description = "Sequential shell steps can capture stdout into an env var and use it in later steps; one trailing newline is trimmed for shell captures."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "kind.shell" }
    contributes { "goal.lang-independent"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/executor.go:runSteps" }
    }
  }
  new {
    id = "runner.steps.sequential"
    name = "steps_run_in_authored_order"
    description = "Test.steps runs each Step in authored order, carries captures forward through the per-test state map, and skips later non-always steps after the first failure."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy"; "goal.lang-independent" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/executor.go:runSteps" }
    }
  }
  new {
    id = "runner.hooks.lifecycle"
    name = "before_after_hooks_with_scopes_and_capture"
    description = "Plan-level before/after hooks run in deterministic key order; scope=all hooks run once per suite, scope=each hooks run per test, and hook stdout can be captured into the body env."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.ci-trustworthy"; "goal.lang-independent" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/executor.go:Run" }
    }
  }
  new {
    id = "kind.http"
    name = "http_kind_with_cassette_replay"
    description = "Step.http issues an HTTP request with body/headers/method; the `cassette` option records or replays the response so the test is deterministic offline."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.playwright"
    name = "playwright_kind_lightweight_harness"
    description = "Step.playwright drives a single page via the embedded Node harness; pixel-diff against ScreenshotSnapshot and expectConsole assertions land here."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "runner.playwright.pixel-diff"
    name = "playwright_screenshot_threshold_uses_pixel_diff"
    description = "When `pixelmatch` and `pngjs` are available, ScreenshotSnapshot compares PNGs by diff percentage against `thresholdPct`, writing `.actual` and `.diff` artifacts on failure; otherwise it falls back to byte-exact comparison with an install hint."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "kind.playwright" }
    contributes { "goal.lang-independent"; "goal.differential" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/playwright.go:checkScreenshot" }
    }
  }
  new {
    id = "runner.playwright.console-assertions"
    name = "playwright_console_assertions"
    description = "Playwright steps can assert required and forbidden console/pageerror substrings through ConsoleAssertion."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    dependsOn { "kind.playwright" }
    contributes { "goal.lang-independent"; "goal.ci-trustworthy" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/playwright.go:checkConsole" }
    }
  }
  new {
    id = "kind.playwright-test"
    name = "playwrightTest_kind_wraps_external_runner"
    description = "Step.playwrightTest delegates to `@playwright/test` (fixtures, traces, retries) and round-trips the JUnit output back to pkspec's tally."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "runner.playwright-test.grep-filter"
    name = "playwright_test_grep_filter_is_forwarded"
    description = "PlaywrightTestSpec.grep is forwarded as `--grep` to @playwright/test so a pkspec step can run a focused subset of a suite."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    dependsOn { "kind.playwright-test" }
    contributes { "goal.lang-independent" }
    implementations {
      new Implementation { kind = "code"; at = "internal/executor/playwrighttest.go:runPlaywrightTestStep" }
    }
  }
  new {
    id = "kind.sql"
    name = "sql_kind_with_embedded_sqlite"
    description = "Step.sql runs against modernc.org/sqlite (pure Go, no cgo). DML and parameterised queries are first-class."
    tags { "spec" }
    severity = "major"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
  }
  new {
    id = "kind.pluggable"
    name = "kind_is_pluggable_via_pkl_class_plus_go_executor"
    description = "Adding a new kind = a Pkl Spec class on Step + a `Step.kind` value + a Go function under internal/executor/. No core changes."
    tags { "spec" }
    severity = "minor"
    reviewStatus = "approved"
    contributes { "goal.lang-independent" }
    implementations {
