amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.9.0#/Taskfile.pkl"

/// Released version. Drives the `tag` task (pkspec@<ver> + v<ver>).
/// Keep in lockstep with moon.mod.json + the
/// pkspec_version() constant in src/cmd/pkspec/main.mbt.
local releaseVersion = "0.4.1"

/// MoonBit sources for the six pkspec binaries (module at repo root).
local sources: Listing<String> = new {
  "src/**/*.mbt"
  "src/**/*.c"
  "src/**/moon.pkg"
  "moon.mod.json"
}

local schemaSources: Listing<String> = new {
  "pkl/**/*.pkl"
  "pkl/**/*.pcf"
}

/// Path to the native release pkspec CLI the MoonBit toolchain emits.
local pkspecBin: String = "_build/native/release/build/src/cmd/pkspec/pkspec.exe"

local default: Task = new {
  name = "default"
  description = "List available tasks"
  cmd = "pkf list"
  cache = false
}

/// Build all six native release binaries from the MoonBit sources
/// (pkspec CLI + the 5 adapter shims). Other dev tasks depend on this
/// and run the built binaries so the gate reflects HEAD, not whatever
/// happens to be on PATH.
local build: Task = new {
  name = "build:pkspec"
  description = "Build the six native release binaries from the repo-root MoonBit module"
  cmd = "moon update && moon build --target native --release"
  inputs = sources
  outputs {
    pkspecBin
    "_build/native/release/build/src/cmd/pkspec-adapter-vitest/pkspec-adapter-vitest.exe"
    "_build/native/release/build/src/cmd/pkspec-adapter-playwright/pkspec-adapter-playwright.exe"
    "_build/native/release/build/src/cmd/pkspec-adapter-node-test/pkspec-adapter-node-test.exe"
    "_build/native/release/build/src/cmd/pkspec-adapter-go-test/pkspec-adapter-go-test.exe"
    "_build/native/release/build/src/cmd/pkspec-adapter-moon-test/pkspec-adapter-moon-test.exe"
  }
}

local moonCheck: Task = new {
  name = "moon:check"
  description = "Type-check the MoonBit sources (native target)"
  cmd = "moon check --target native"
  inputs = sources
}

local moonTest: Task = new {
  name = "moon:test"
  description = "MoonBit unit tests — evaluator + model gates (native target)"
  cmd = "moon test --target native"
  inputs = sources
}

local testPkl: Task = new {
  name = "test:pkl"
  description = "Pkl schema tests"
  cmd = "pkl test pkl/Test.test.pkl pkl/Adapter.test.pkl pkl/QuickCheck.test.pkl"
  inputs = schemaSources
}

local actionLint: Task = new {
  name = "action-lint"
  description = "Lint GitHub Actions workflows"
  cmd = "actionlint"
  cache = false
  inputs {
    "action.yml"
    ".github/workflows/**"
  }
}

/// MoonBit conformance harness: candidate pkspec vs frozen goldens
/// (71/71 strict). Stages the five adapter shims on PATH under their
/// bare names (the Pkl `adapterCommand` spawns them by bare name) and
/// points PKSPEC_BIN at the freshly built CLI, mirroring
/// `.github/workflows/conformance.yml`.
local conformance: Task = new {
  name = "conformance"
  description = "MoonBit pkspec contract harness: candidate vs frozen goldens (71/71 strict)"
  cmd =
    #"""
    set -euo pipefail
    build="$PWD/_build/native/release/build/src/cmd"
    shimbin="$PWD/.shim-bin"
    mkdir -p "$shimbin"
    for k in go-test moon-test node-test vitest playwright; do
      cp "$build/pkspec-adapter-$k/pkspec-adapter-$k.exe" "$shimbin/pkspec-adapter-$k"
    done
    export PATH="$shimbin:$PATH"
    export PKSPEC_BIN="$build/pkspec/pkspec.exe"
    cd conformance && moon update && moon run --target native --release src
    """#
  deps { build }
  cache = false
}

/// Pre-commit gate: moon check/test + pkl schema tests + action-lint.
/// Skips the conformance harness (CI's job, slower).
local preflight: Task = new {
  name = "preflight"
  description = "Pre-commit gate: moon check/test + pkl tests + action-lint"
  deps {
    moonCheck
    moonTest
    testPkl
    actionLint
  }
}

/// Git pre-commit hook target (delegates to preflight).
local preCommit: Task = new {
  name = "pre-commit"
  description = "Git pre-commit hook target (delegates to preflight)"
  deps { preflight }
}

/// Local-only: creates `pkspec@<ver>` + `v<ver>` at HEAD but does NOT
/// push. Push manually after reviewing — pushing `pkspec@<ver>`
/// triggers the Release workflow (matrix build + GitHub release + nix
/// pin sync), and `v-tags.yml` then syncs the action-friendly v-tags.
local tag: Task = new {
  name = "tag"
  description = "Create the pkspec@<ver> + v<ver> tags locally (no push)"
  cache = false
  cmd =
    """
    set -euo pipefail
    ver="$VERSION"
    for t in "pkspec@$ver" "v$ver"; do
      if git rev-parse "$t" >/dev/null 2>&1; then
        echo "tag $t already exists locally" >&2
        exit 1
      fi
    done
    git tag "pkspec@$ver"
    git tag "v$ver"
    echo "created tags: pkspec@$ver  v$ver"
    echo "  push with: git push origin pkspec@$ver v$ver"
    """
  params {
    new {
      name = "version"
      type = "string"
      default = releaseVersion
      description = "release version without the leading v (default: \(releaseVersion))"
    }
  }
}

tasks {
  default
  build
  moonCheck
  moonTest
  testPkl
  actionLint
  conformance
  preflight
  preCommit
  tag
}
