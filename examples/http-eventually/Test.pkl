amends "../../pkl/Test.pkl"

tests {
  new {
    name = "poll_until_ready"
    description = "server returns 503 for ~1s, then 200; eventually polls until pass"
    tags { "unit" }
    specRef { "parallel.background"; "runner.eventually"; "kind.http" }
    background {
      new {
        name = "server"
        cmd = "python3 server.py"
        readyProbe =
          "curl -fs -o /dev/null -w '%{http_code}' http://127.0.0.1:19012/ | grep -E '503|200' > /dev/null"
        readyTimeoutSec = 5
      }
    }
    body = new SequentialTest {
      steps {
        new {
          name = "wait"
          body = new HttpBody {
            http = new HttpRequest {
              method = "GET"
              url = "http://127.0.0.1:19012/health"
            }
            expectStatus = 200
            expectBodyJsonPath { ["ready"] = true }
          }
          eventually = new Eventually {
            intervalMs = 200
            timeoutSec = 5
          }
        }
      }
    }
  }
}
