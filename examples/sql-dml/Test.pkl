amends "../../pkl/Test.pkl"

tests {
  new {
    name = "dml_sequence"
    description = "Create → Insert → Verify → Update → Verify → Delete → Verify empty"
    tags { "unit" }
    specRef { "kind.sql"; "runner.steps.sequential" }
    body = new SequentialTest {
      steps {
        new {
          name = "create"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query = "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT, role TEXT)"
            }
          }
        }
        new {
          name = "insert_2"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query =
                "INSERT INTO users (email, role) VALUES ('a@x.test', 'admin'), ('b@x.test', 'user')"
              expectRowCount = 2
            }
          }
        }
        new {
          name = "verify_initial"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query = "SELECT email, role FROM users ORDER BY id"
              expectRowCount = 2
              expectRowsJsonPath {
                ["0.email"] = "a@x.test"
                ["1.role"] = "user"
              }
            }
          }
        }
        new {
          name = "update_1"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query = "UPDATE users SET role = 'superadmin' WHERE email = 'a@x.test'"
              expectRowCount = 1
            }
          }
        }
        new {
          name = "verify_updated"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query = "SELECT role FROM users WHERE email = 'a@x.test'"
              expectRowsJsonPath { ["0.role"] = "superadmin" }
            }
          }
        }
        new {
          name = "delete_all"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query = "DELETE FROM users"
              expectRowCount = 2
            }
          }
        }
        new {
          name = "verify_empty"
          body = new SqlBody {
            sql = new SqlSpec {
              dsn = "sqlite:work.db"
              query = "SELECT COUNT(*) AS n FROM users"
              expectRowsJsonPath { ["0.n"] = 0 }
            }
          }
        }
        new {
          name = "cleanup"
          body = new ShellBody { cmd = "rm -f work.db" }
        }
      }
    }
  }
}
