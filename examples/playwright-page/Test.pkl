amends "../../pkl/Test.pkl"

tests {
  new {
    name = "render_label"
    description = "lightweight playwright: setContent + return text"
    tags { "unit" }
    specRef { "kind.playwright" }
    env { ["LABEL"] = "world" }
    body = new SequentialTest {
      steps {
        new {
          name = "render"
          body = new PlaywrightBody {
            playwright = new PlaywrightSpec {
              script = "scripts/render.mjs"
              browser = "chromium"
            }
          }
          timeoutSec = 30
        }
      }
    }
  }
}
